local Script = {}

function Script:Spawn()
	self.transform = Transform.Add(self.ID)
	self.transform:SetParent(Grid.BoardID)
	self.ui_image = UIImage.Add(self.ID)
	self.ui_image:SetPivot(0.5,0.5)
	self.ui_image:SetOrder(2)
	self.animation = Animation2D.Add(self.ID)
	self.animations = {}
end

---자원 종류의 이미지를 설정합니다. 이동은 RoadTransport가 그룹 단위로 처리합니다.
---@param resourceIndex number EnergyList의 자원 인덱스
---@return boolean success 이미지 설정 성공 여부
function Script:Setting(resourceIndex)
	local item = EnergyList[resourceIndex]
	if not item then
		return false
	end
	self.ui_image:SetTexture(item.Texture)
	self.ui_image:SetColor(255,0,0,255)
	self.ui_image:SetTextureSize(RoadTransport.Size,RoadTransport.Size)
	return EnergyList.Play(self.animation,self.animations,resourceIndex,false)
end

return Script
