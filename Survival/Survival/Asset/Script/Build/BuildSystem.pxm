local Script = {}

function Script:Spawn()
    self.transform = Transform.Add(self.ID)
    self.ui_image = UIImage.Add(self.ID)
    self.ui_image:SetTexture("grid")
    self.ui_image:SetPivot(0.5, 0.5)

    self.transform.position = PVector3(1920 *0.5 , 1080 * 0.5,0)
    self.transform.scale = PVector3(4,4,4)
    self:CreateGrid()
    Grid.BoardID = self.ID
	self.IsEditing = false
	self.IsLocked = false
	self.IsTesting = false
	Event.Bind(self.ID,"BuildEdit","BeginEdit")
	Event.Bind(self.ID,"BuildPlay","ResumePlay")
	Event.Bind(self.ID,"ToggleBuildTest","ToggleTest")
	Event.Bind(self.ID,"StopBuildTest","StopTest")
end

--Private
function Script:CreateGrid()
    RoadTransport.Reset()
    Grid.RoadGroups = {}
    for x = 1, Grid.width do
        for _, cell in pairs(Grid[x] or {}) do
            if cell.ID then
                Entity.Destroy(cell.ID)
            end
        end
        Grid[x] ={}
        for y = 1, Grid.height do
            Grid[x][y] = {ItemIndex = -1,ID = nil,Script = nil}
        end
    end
end

function Script:Add(x,y,index)
	if self.IsLocked then
		return false
	end
	if not self:Check(x,y) then
		return false
	end
	if type(index) ~= "number" or index % 1 ~= 0 or index < -1 then
		return false
	end
	local cell = Grid[x][y]
	if cell.ItemIndex == index and cell.ID then
		return true
	end
	if self.IsEditing then
		self:StopTest()
	end
	local id = nil
	if index ~= -1 then
		id = self:CreateEntity(index)
		if id == nil or id == 4294967295 then
			return false
		end
	end
	if cell.ID then
		Entity.Destroy(cell.ID)
	end
	cell.ItemIndex = index
	cell.ID = id
	cell.Script = nil
	if id then
		cell.Script = Entity.GetScript(id)
		local transform = Transform.Get(id)
		transform.position = PVector3(-120 + (x - 0.5) * (240 / Grid.width),-120 + (y - 0.5) * (240 / Grid.height),0)
		transform.rotation.z = 0
		transform.scale = PVector3(1,1,1)
	end
	Grid.RebuildRoadGroups()
	if cell.Script then
		if index == 1 then
			cell.Script:Setting(x,y,cell.RoadGroup)
		else
			cell.Script:Setting(x,y)
		end
	end
	return true
end




function Script:Update(DTime)
	local deltaTime = DTime
	if self.IsEditing then
		if not self.IsTesting then
			return
		end
		deltaTime = Time.GetUnscaledDeltaTime()
	end
	if deltaTime <= 0 then
		return
	end
	-- 생산 → 이동 → 회수 순서를 고정하고 개별 Entity 업데이트의 이중 진행을 막는다.
	for x = 1, Grid.width do
		for y = 1, Grid.height do
			local cell = Grid[x][y]
			if cell.ItemIndex == 2 and cell.Script then
				cell.Script:Tick(deltaTime)
			end
		end
	end
	RoadTransport.Update(deltaTime)
	for x = 1, Grid.width do
		for y = 1, Grid.height do
			local cell = Grid[x][y]
			if cell.ItemIndex == 3 and cell.Script then
				cell.Script:Tick(deltaTime)
			end
		end
	end
end

---실제 자원과 생산 시간을 보관하고 빌드 수정 단계로 들어갑니다.
function Script:BeginEdit()
	if self.IsEditing then
		return
	end
	self.IsEditing = true
	self.IsLocked = false
	self.IsTesting = false
	self.SavedResources = RoadTransport.Resources
	self.SavedGroups = {}
	self.SavedInputs = {}
	for _, group in ipairs(Grid.RoadGroups) do
		self.SavedGroups[#self.SavedGroups + 1] = {
			Group = group,Resources = group.Resources,Gaps = group.Gaps,
			HeadDistance = group.HeadDistance,TailDistance = group.TailDistance,CompressIndex = group.CompressIndex,
		}
	end
	for _, resource in ipairs(self.SavedResources) do
		Entity.SetActive(resource.ID,false)
	end
	for x = 1, Grid.width do
		for y = 1, Grid.height do
			local cell = Grid[x][y]
			if cell.ItemIndex == 2 and cell.Script then
				self.SavedInputs[cell.Script] = cell.Script.Elapsed
			end
		end
	end
	RoadTransport.Resources = {}
	RoadTransport.ClearResources()
end

---테스트용 자원만 지우고 실제 게임 자원은 보관합니다.
function Script:StopTest()
	if not self.IsEditing then
		return
	end
	self.IsTesting = false
	RoadTransport.ClearResources()
end

---수정 단계에서는 실제 시간으로 테스트를 켜거나 끕니다.
function Script:ToggleTest()
	if not self.IsEditing then
		return false
	end
	if self.IsTesting then
		self:StopTest()
		return true
	end
	self:StopTest()
	for x = 1, Grid.width do
		for y = 1, Grid.height do
			local cell = Grid[x][y]
			if cell.ItemIndex == 2 and cell.Script then
				cell.Script.Elapsed = 0
			end
		end
	end
	self.IsTesting = true
	return true
end

---테스트 이전 자원과 생산 시간을 복원하고 플레이 중 편집을 잠급니다.
function Script:ResumePlay()
	if self.IsEditing then
		self:StopTest()
		RoadTransport.Resources = self.SavedResources
		local unchanged = #self.SavedGroups == #Grid.RoadGroups
		for i, saved in ipairs(self.SavedGroups) do
			if Grid.RoadGroups[i] ~= saved.Group then
				unchanged = false
			end
		end
		if unchanged then
			for _, saved in ipairs(self.SavedGroups) do
				local group = saved.Group
				group.Resources,group.Gaps = saved.Resources,saved.Gaps
				group.HeadDistance,group.TailDistance = saved.HeadDistance,saved.TailDistance
				group.CompressIndex = saved.CompressIndex
			end
		else
			RoadTransport.Rebind()
		end
		for _, resource in ipairs(RoadTransport.Resources) do
			Entity.SetActive(resource.ID,true)
		end
		for x = 1, Grid.width do
			for y = 1, Grid.height do
				local cell = Grid[x][y]
				if cell.ItemIndex == 2 and cell.Script then
					cell.Script.Elapsed = self.SavedInputs[cell.Script] or 0
				end
			end
		end
		self.SavedResources,self.SavedGroups,self.SavedInputs = nil,nil,nil
	end
	self.IsEditing = false
	self.IsTesting = false
	self.IsLocked = true
end

function Script:Check(x,y)
    if type(x) ~= "number" or type(y) ~= "number" then
        return false
    end
    if x % 1 ~= 0 or y % 1 ~= 0 then
        return false
    end
    if x < 1 or x > Grid.width or y < 1 or y > Grid.height then
        return false
    end
    if type(Grid[x]) ~= "table" or type(Grid[x][y]) ~= "table" then
        return false
    end
    return true
end

function Script:CreateEntity(index)
	if index == 1 then
		return Entity.Create("Road")
	end
	if index == 2 then
		return Entity.Create("BasicInput")
	end
	if index == 3 then
		return Entity.Create("BasicOutput")
	end
	local item = ItemList[index]
	if item == nil or type(item.Texture) ~= "string" or item.Texture == "" then
		return nil
	end
	return Entity.Create("BuildItem")
end




return Script
