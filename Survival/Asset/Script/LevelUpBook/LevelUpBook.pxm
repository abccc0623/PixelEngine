local Script = {}

function Script:Spawn()
	self.transform = Transform.Add(self.ID)
	self.transform.position = PVector3(960,540,1)
	self.transform.scale = PVector3(3,3,1)
	self.image = UIImage.Add(self.ID)
	self.image:SetOrder(-100)
	self.animation = Animation2D.Add(self.ID)
	self.animation:SetUseUnscaledTime(true)
	self.animationList = {
		open = self.animation:Create("Open_book",8,1,1),
		next = self.animation:Create("Next_book",9,1,1),
		close = self.animation:Create("Close_book",5,1,1),
		idle = self.animation:Create("Idle_book",1,1,1),
	}
	for _, name in ipairs({"open","next","close"}) do
		self.animation:SetLoop(self.animationList[name],false)
	end
	self.animation:SetFrameCallback(self.animationList.open,7,false)
	self.animation:SetFrameCallback(self.animationList.next,8,false)
	self.animation:SetFrameCallback(self.animationList.close,4,false)
	self.Pages = {}
	self.PageIndex = 1
	self:AddPage("LevelUpChoicePage")
	self:AddPage("LevelUpBuildPage")
	self:Idle()
	self.State = "closed"
	Entity.SetActive(self.ID,false)
end

---페이지 객체를 등록합니다. 이름을 생략하면 비어 있는 페이지를 만듭니다.
---@param scriptName? string Setting(bookID), Show(), Hide()를 제공하는 페이지 스크립트
---@return number pageIndex 등록된 페이지 순서
function Script:AddPage(scriptName)
	local id
	local page
	if scriptName then
		id = Entity.Create(scriptName)
		page = Entity.GetScript(id)
		page:Setting(self.ID)
	else
		id = Entity.CreateEmpty()
		Transform.Add(id):SetParent(self.ID)
	end
	self.Pages[#self.Pages + 1] = {ID = id,Script = page}
	if page then
		page:Hide()
	else
		Entity.SetActive(id,false)
	end
	return #self.Pages
end

function Script:HidePages()
	for _, page in ipairs(self.Pages) do
		if page.Script then
			page.Script:Hide()
		else
			Entity.SetActive(page.ID,false)
		end
	end
end

function Script:ShowPage()
	self:HidePages()
	local page = self.Pages[self.PageIndex]
	if page.Script then
		page.Script:Show()
	else
		Entity.SetActive(page.ID,true)
	end
end

---기존 Book과 동일하게 프레임 여백을 보정해 책 위치를 유지합니다.
function Script:SetBookLayout(width,centerX,bottomY)
	self.image:SetTextureSize(width,640)
	self.image:SetPivot((centerX - 4) / width,(bottomY - 136) / 640)
end

function Script:Idle()
	self:SetBookLayout(768,388,456)
	self.State = "idle"
	self.currentAnimationID = self.animationList.idle
	self.animation:Play(self.currentAnimationID)
	self.animation:Reset()
	self.animation:Stop()
end

---책을 표시하고 열기 애니메이션을 재생합니다.
---@return boolean success 재생 시작 여부
function Script:Show()
	if self.State ~= "closed" then
		return false
	end
	self:SetBookLayout(608,308,449)
	self.State = "opening"
	self.PageIndex = 1
	self.SelectedItemIndex = nil
	self.currentAnimationID = self.animationList.open
	for _, page in ipairs(self.Pages) do
		if page.Script and page.Script.OnBookOpened then
			page.Script:OnBookOpened()
		end
	end
	Entity.SetActive(self.ID,true)
	self:HidePages()
	self.animation:Play(self.currentAnimationID)
	self.animation:Reset()
	return true
end

---펼쳐진 책의 다음 페이지 애니메이션을 재생합니다.
---@return boolean success 재생 시작 여부
function Script:Next()
	if self.State ~= "idle" or not self.Pages[self.PageIndex + 1] then
		return false
	end
	self:HidePages()
	self.PendingPageIndex = self.PageIndex + 1
	self:SetBookLayout(608,308,562)
	self.State = "turning"
	self.currentAnimationID = self.animationList.next
	self.animation:Play(self.currentAnimationID)
	self.animation:Reset()
	return true
end

---닫기 애니메이션 완료 후 책을 비활성화합니다.
---@return boolean success 재생 시작 여부
function Script:Close()
	if self.State ~= "idle" then
		return false
	end
	self:HidePages()
	self:SetBookLayout(608,308,560)
	self.State = "closing"
	self.currentAnimationID = self.animationList.close
	self.animation:Play(self.currentAnimationID)
	self.animation:Reset()
	return true
end

---선택한 번호를 저장하고 다음 페이지로 넘깁니다. 아이템 지급은 별도로 연결합니다.
---@param itemIndex number ItemList 인덱스
---@return boolean success 다음 페이지 전환 시작 여부
function Script:SelectItem(itemIndex)
	if self.State ~= "idle" or self.PageIndex ~= 1 or type(itemIndex) ~= "number" or not ItemList[itemIndex] then
		return false
	end
	if not self:Next() then
		return false
	end
	self.SelectedItemIndex = itemIndex
	return true
end

function Script:Update()
	if self.State ~= "idle" then
		return
	end
	local page = self.Pages[self.PageIndex]
	if page.Script and page.Script.HandlesInput then
		return
	end
	if Input.KeyDown(Keycode.X) then
		self:Close()
	elseif self.PageIndex > 1 and Input.KeyDown(Keycode.Z) then
		self:Next()
	end
end

function Script:OnAnimationCallBack(targetID,nowAnimationID,nowAnimationFrame)
	if targetID ~= self.ID or nowAnimationID ~= self.currentAnimationID then
		return
	end
	if nowAnimationID == self.animationList.open or nowAnimationID == self.animationList.next then
		if nowAnimationID == self.animationList.next then
			self.PageIndex = self.PendingPageIndex
			self.PendingPageIndex = nil
		end
		self:Idle()
		self:ShowPage()
	elseif nowAnimationID == self.animationList.close then
		self.animation:Stop()
		self.State = "closed"
		Entity.SetActive(self.ID,false)
		for _, page in ipairs(self.Pages) do
			if page.Script and page.Script.OnBookClosed then
				page.Script:OnBookClosed()
			end
		end
	end
end

return Script
