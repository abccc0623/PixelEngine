local Script = {}

function Script:Spawn()
    self.transform = Transform.Add(self.ID)
    self.selectIndex = 1
    Event.Bind(self.ID, "ShowRandomCard", "Show")
    Event.Bind(self.ID, "HideBookContent", "Hide")

    self.UIList = {}
    self.choiceImages = {}
    self.descriptionTexts = {}

    self:AddUI(UI.CreateBookTitleIcon("ContentIcon"))
    self:AddUI(UI.CreateBookTitleText("능력 선택"))
    self:AddUI(UI.CreateBookSubText(116.5,-140,"설명",150))
    self:CreateLine(116.5,0)
    self:CreateLine(116.5,40)
    self:CreateLine(116.5,80)
    self:CreateSelectContentIcon(116.5,-80)

    local startPoint = -80
    for i = 1, 4 do
        local choiceID, nameText, typeText, nameID, typeID = UI.CreateChoiceImage(-116.5,startPoint)
        self:AddUI(choiceID,nameID,typeID)
        UpgradeUIList[i].TitleComponent = nameText
        UpgradeUIList[i].TypeComponent = typeText
        local iconID = Entity.CreateEmpty()
        local iconTransform = Transform.Add(iconID)
        iconTransform:SetParent(choiceID)
        self:AddUI(iconID)
        iconTransform.position = PVector3(-70.5,-3.5,0)
        local iconImage = UIImage.Add(iconID)
        iconImage:SetPivot(0.5,0.5)
        iconImage:SetOrder(1)
        self.choiceImages[i] = iconImage
        UpgradeUIList[i].ImageComponent = iconImage
        startPoint = startPoint + 50
    end
    self:CreateSelectUI(-210, -84)
    self:Hide()

end

function Script:Hide()
    for _, id in ipairs(self.UIList) do Entity.SetActive(id,false) end
    Entity.SetActive(self.ID, false)
end

function Script:Show()
    UpgradeListFunction.Shuffle()
    for _, image in ipairs(self.choiceImages) do image:SetAspectFit(26,26) end
    self.selectIndex = 1
    self:MoveSelect()
    Entity.SetActive(self.ID, true)
    for _, id in ipairs(self.UIList) do Entity.SetActive(id,true) end
end

function Script:Update()
    if self.choiceSelectTransform == nil then return end
    local previous = self.selectIndex
    if Input.KeyDown(Keycode.Up) then
        self.selectIndex = math.max(1,self.selectIndex - 1)
    elseif Input.KeyDown(Keycode.Down) then
        self.selectIndex = math.min(4,self.selectIndex + 1)
    end
    if previous ~= self.selectIndex then self:MoveSelect() end

    if Input.KeyDown(Keycode.X) then
        self:Hide()
        Event.Call("BookClose")
        return
    end

    if Input.KeyDown(Keycode.Z) then
        UpgradeListFunction.Choice(self.selectIndex)
        self:Hide()
        Event.Call("BookNext")
    end
end

function Script:MoveSelect()
    if self.choiceSelectTransform ~= nil then
        self.choiceSelectTransform.position = PVector3(-210,-84 + (self.selectIndex - 1) * 50,0)
    end
    local item = ItemList[UpgradeList[self.selectIndex].ItemIndex]
    if item and self.selectedContentImage then
        self.selectedContentImage:SetTexture(item.Texture)
        self.selectedContentImage:SetAspectFit(200,200)
    end
    local lines = {}
    for paragraph in ((item and item.UpgradeContent or "") .. "\n"):gmatch("([^\n]*)\n") do
        local line, count = "", 0
        for word in paragraph:gmatch("%S+") do
            local _, length = word:gsub("[%z\1-\127\194-\244][\128-\191]*", "")
            if count > 0 and count + 1 + length > 18 then
                lines[#lines + 1] = line
                line, count = "", 0
            end
            if count > 0 then line = line .. " "; count = count + 1 end
            line, count = line .. word, count + length
        end
        lines[#lines + 1] = line
    end
    for index, text in ipairs(self.descriptionTexts) do text:SetText(lines[index] or "") end
end

function Script:CreateSelectUI(x,y)
    local targetID = Entity.CreateEmpty()
    self:AddUI(targetID)
    local targetTr = Transform.Add(targetID)
    self.choiceSelectTransform = targetTr
    local image = UIImage.Add(targetID)
    image:SetTexture("Right")
    image:SetPivot(0.5, 0.5)
    targetTr.position = PVector3(x,y,0)
    targetTr.scale = PVector3(1.5,1.5,1)
    targetTr:SetParent(UI.BookID)
end

function Script:CreateLine(x,y)
    local targetID = Entity.CreateEmpty()
    self:AddUI(targetID)
    local targetTr = Transform.Add(targetID)
    local image = UIImage.Add(targetID)
    image:SetTexture("line_3")
    image:SetPivot(0.5, 0.5)
    targetTr.position = PVector3(x,y,0)
    targetTr.scale = PVector3(0.75,0.75,1)
    targetTr:SetParent(UI.BookID)
    for lineIndex = 0, 1 do
        local textID = Entity.CreateEmpty()
        self:AddUI(textID)
        local textTr = Transform.Add(textID)
        textTr:SetParent(targetID)
        textTr.position = PVector3(-114,-20 + lineIndex * 26,0)
        local text = UIText.Add(textID)
        text:SetFont("Jalnan2TTF")
        text:SetTextSize(0.4)
        text:SetPivot(0,0.5)
        text:SetColor(37,35,35,255)
        self.descriptionTexts[#self.descriptionTexts + 1] = text
    end
end

function Script:CreateSelectContentIcon(x,y)
    local targetID = Entity.CreateEmpty()
    self:AddUI(targetID)
    local targetTr = Transform.Add(targetID)
    local image = UIImage.Add(targetID)
    image:SetTexture("tile")
    image:SetPivot(0.5, 0.5)
    targetTr.position = PVector3(x,y,0)
    targetTr.scale = PVector3(1,1,1)
    targetTr:SetParent(UI.BookID)
    local iconID = Entity.CreateEmpty()
    self:AddUI(iconID)
    local iconTr = Transform.Add(iconID)
    iconTr:SetParent(targetID)
    iconTr.position = PVector3(0,0,0)
    iconTr.scale = PVector3(0.2,0.2,1)
    local iconImage = UIImage.Add(iconID)
    iconImage:SetPivot(0.5,0.5)
    iconImage:SetOrder(1)
    self.selectedContentImage = iconImage
end


function Script:AddUI(...)
    for _, id in ipairs({...}) do self.UIList[#self.UIList + 1] = id end
end

return Script
