local Script = {}
function Script:Spawn()
    self.UIList = {}
    self.SelectTr = -1
    self.SelectW, self.SelectH = 1, 1
    self.KeyRepeatStates = {}
    self.CellPositions = {}
    GridUI, GridTransform = {}, {}

    self:AddUI(UI.CreateBookTitleIcon("BuildIcon"))
    self:AddUI(UI.CreateBookTitleText("빌드"))
    self:CreateGrid()
    self:CreateGridSelect()

    Event.Bind(self.ID,"ShowGrid", "Show")
    Event.Bind(self.ID,"HideBookContent", "Hide")
    self:Hide()
end

function Script:Hide()
    Grid.Visible = false
    for _, id in ipairs(self.UIList) do Entity.SetActive(id,false) end
    Entity.SetActive(self.ID, false)
end

function Script:Show()
    Grid.Visible = true
    Entity.SetActive(self.ID, true)
    for _, id in ipairs(self.UIList) do Entity.SetActive(id,true) end
    if self.SelectTr == -1 then return end
    -- Parent activation also activates children, so restore each item's state.
    for x = 1, Grid.width do
        for y = 1, Grid.height do
            Entity.SetActive(GridUI[x][y].thisID,Grid[x][y].ItemIndex ~= 0)
        end
    end
    self:GridCheck(1,1)
end

function Script:CreateGridImage(x,y)
    local targetID = Entity.CreateEmpty()
    self:AddUI(targetID)
    local targetTr = Transform.Add(targetID)
    local image = UIImage.Add(targetID)
    image:SetTexture("box")
    image:SetPivot(0.5,0.5)
    image:SetTextureSize(18,18)

    local cell = Grid[x][y]
    if cell.ItemIndex ~= 0 then image:SetTexture(ItemList[cell.ItemIndex].Texture) end
    image:SetColor(255,255,255,255)
    image:SetOrder(-70)
    targetTr.rotation.z = cell.ItemRotation
    targetTr.position = self.CellPositions[x][y]
    targetTr:SetParent(self.GridID)
    GridTransform[x][y] = targetTr
    Entity.SetActive(targetID,Grid.Visible == true and cell.ItemIndex ~= 0)
    return image
end

function Script:CreateGridSelect()
    local targetID = Entity.CreateEmpty()
    self:AddUI(targetID)
    self.SelectTr = Transform.Add(targetID)
    local image = UIImage.Add(targetID)
    image:SetTexture("UISelect_thick")
    image:SetTextureSize(20,20)
    image:SetPivot(0.5,0.5)
    image:SetOrder(-1)

    self.SelectTr.position = self.CellPositions[self.SelectW][self.SelectH]
    self.SelectTr.scale = PVector3(1,1,1)
    self.SelectTr:SetParent(self.GridID)
end

function Script:Update(DTime)
    if self.SelectTr == -1 then
        return
    end

    if Input.Key(Keycode.X) then return end

    local RTime = Time.GetUnscaledDeltaTime()
    self:HandleMoveKey(Keycode.Up, 0, -1, RTime)
    self:HandleMoveKey(Keycode.Down, 0, 1, RTime)
    self:HandleMoveKey(Keycode.Left, -1, 0, RTime)
    self:HandleMoveKey(Keycode.Right, 1, 0, RTime)

	if Input.KeyDown(Keycode.Escape) then
		Event.Call("BookClose")
		self:Hide()
	end

    if Input.KeyDown(Keycode.Z) then
        local selectType = User.Selection.Type
        local selectIndex = User.Selection.Index

        if selectType == InventoryType.Tool then
            local tool = User.Tools[selectIndex]
            if tool ~= nil and tool.Action ~= nil then tool.Action(self.SelectW,self.SelectH) end
        elseif selectType == InventoryType.Inventory then
            local inventory = User.Inventory[selectIndex]
            if inventory == nil or inventory.ItemIndex <= 0 or inventory.ItemCount <= 0 then return end

            local itemIndex = inventory.ItemIndex
            if GridFunction.Add(self.SelectW,self.SelectH,itemIndex) then
                InventoryFunction.Place(selectIndex)
            end
        end
    end
end

function Script:GridCheck(x, y)
    if x < 1 or x > Grid.width then
        return
    end
    if y < 1 or y > Grid.height then
        return
    end

    self.SelectW = x
    self.SelectH = y
    self.SelectTr.position = self.CellPositions[x][y]
end

function Script:HandleMoveKey(keycode, moveW, moveH, DTime)
    local state = self.KeyRepeatStates[keycode]

    if state == nil then
        state = { HoldTime = 0, RepeatTime = 0 }
        self.KeyRepeatStates[keycode] = state
    end

    if Input.KeyDown(keycode) then
        state.HoldTime = 0
        state.RepeatTime = 0
        self:GridCheck(self.SelectW + moveW, self.SelectH + moveH)
        return
    end

    if Input.Key(keycode) then
        state.HoldTime = state.HoldTime + DTime

        if state.HoldTime >= 0.5 then
            state.RepeatTime = state.RepeatTime + DTime

            if state.RepeatTime >= 0.08 then
                state.RepeatTime = state.RepeatTime - 0.08
                self:GridCheck(self.SelectW + moveW, self.SelectH + moveH)
            end
        end
    else
        state.HoldTime = 0
        state.RepeatTime = 0
    end
end

function Script:CreateGrid()
    local targetID = Entity.CreateEmpty()
    self:AddUI(targetID)
    local transform = Transform.Add(targetID)
    local image = UIImage.Add(targetID)
    transform:SetParent(UI.BookID)
    image:SetTexture("grid")
    image:SetTextureSize(256,256)
    image:SetPivot(0.5,0.5)
    transform.position = PVector3(-116.5,-10,0)
    transform.scale = PVector3(0.8,0.8,1)
    image:SetOrder(-80)
    self.GridID = targetID
    for x = 1, Grid.width do
        self.CellPositions[x], GridUI[x], GridTransform[x] = {}, {}, {}
        for y = 1, Grid.height do
            self.CellPositions[x][y] = PVector3(-120 + (x - 0.5) * (240 / Grid.width),-120 + (y - 0.5) * (240 / Grid.height),0)
            GridUI[x][y] = self:CreateGridImage(x,y)
        end
    end
end

function Script:AddUI(...)
    for _, id in ipairs({...}) do self.UIList[#self.UIList + 1] = id end
end

return Script
