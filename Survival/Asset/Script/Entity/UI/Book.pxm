local Script = {}

function Script:Spawn()
    UI.BookID = self.ID
    self.transform = Transform.Add(self.ID)
    self.transform.position = PVector3(960,540,1)
    self.transform.scale = PVector3(3,3,1)

    local image = UIImage.Add(self.ID)
    image:SetPivot(0.5,0.5)
    image:SetTextureSize(608,640)
    image:SetOrder(-100)
    self.image = image

    self.animation = Animation2D.Add(self.ID)
    self.animation:SetUseUnscaledTime(true)
    self.animationList = {
        open = self.animation:Create("Open_book",8,1,0.65),
        close = self.animation:Create("Close_book",5,1,0.65),
        next = self.animation:Create("Next_book",9,1,0.65),
        idle = self.animation:Create("Idle_book",1,1,1),
    }
    
    for _, name in ipairs({"open","close","next"}) do
        self.animation:SetLoop(self.animationList[name],false)
    end
    self.animation:SetFrameCallback(self.animationList.open,7,false)
    self.animation:SetFrameCallback(self.animationList.close,4,false)
    self.animation:SetFrameCallback(self.animationList.next,8,false)

    Event.Bind(self.ID,"BookOpen","BookOpen")
    Event.Bind(self.ID,"BookNext","BookNext")
    Event.Bind(self.ID,"BookClose","BookClose")
    self.currentAnimationID = self.animationList.open
    self.animation:Play(self.currentAnimationID)
end

function Script:OnAnimationCallBack(targetID,nowAnimationID,nowAnimationFrame)
    if targetID ~= self.ID or nowAnimationID ~= self.currentAnimationID then return end
    if nowAnimationID == self.animationList.open then
        self:BookIdle()
        Event.Call("ShowRandomCard")
    elseif nowAnimationID == self.animationList.next then
        self:BookIdle()
        Event.Call("ShowGrid")
        Event.Call("ShowInventory")
    elseif nowAnimationID == self.animationList.close then
        Entity.SetActive(self.ID,false)
    end
end

function Script:BookIdle()
    self.image:SetPivot(0.5,0.5)
    self.image:SetTextureSize(768,640)
    self.currentAnimationID = self.animationList.idle
    self.animation:Play(self.currentAnimationID)
    self.animation:Reset()
    self.animation:Stop()
end

function Script:BookOpen()
    self.image:SetPivot(0.5,0.5)
    self.image:SetTextureSize(608,640)
    Entity.SetActive(self.ID,true)
    Event.Call("HideBookContent")
    self.currentAnimationID = self.animationList.open
    self.animation:Play(self.currentAnimationID)
    self.animation:Reset()
end

function Script:BookNext()
    -- Align Next_book's paper baseline (561) with Idle_book's baseline (455).
    self.image:SetPivot(0.5,0.5 + 106 / 640)
    self.image:SetTextureSize(608,640)
    Event.Call("HideBookContent")
    self.currentAnimationID = self.animationList.next
    self.animation:Play(self.currentAnimationID)
    self.animation:Reset()
end

function Script:BookClose()
    self.image:SetPivot(0.5,0.5)
    self.image:SetTextureSize(608,640)
    Event.Call("HideBookContent")
    self.currentAnimationID = self.animationList.close
    self.animation:Play(self.currentAnimationID)
    self.animation:Reset()
end

return Script
