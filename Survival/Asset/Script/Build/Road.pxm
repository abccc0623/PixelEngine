local Script = {}

function Script:Spawn()
	local item = ItemList[1]
	self.Input = PVector2(item.Input.x,item.Input.y)
	self.OutPut = PVector2(item.OutPut.x,item.OutPut.y)
	self.transform = Transform.Add(self.ID)
	self.transform:SetParent(Grid.BoardID)
	self.ui_image = UIImage.Add(self.ID)
	self.ui_image:SetPivot(0.5,0.5)
	self.ui_image:SetOrder(1)
	self:UpdateVisual()
end

---입력·출력 방향에 맞는 직선 또는 코너 텍스처와 회전을 적용합니다.
---@return boolean success 유효한 방향 조합이면 true
function Script:UpdateVisual()
	local input,output = self.Input,self.OutPut
	if not input or not output then
		return false
	end
	if math.abs(input.x) + math.abs(input.y) ~= 1 or math.abs(output.x) + math.abs(output.y) ~= 1 then
		return false
	end
	if input.x == output.x and input.y == output.y then
		return false
	end
	local rotations = {["1:0"] = 0,["0:1"] = 90,["-1:0"] = 180,["0:-1"] = 270}
	local function DirectionKey(direction)
		local x = direction.x == 0 and 0 or direction.x
		local y = direction.y == 0 and 0 or direction.y
		return x .. ":" .. y
	end
	local rotation = rotations[DirectionKey(output)]
	if rotation == nil or rotations[DirectionKey(input)] == nil then
		return false
	end
	local texture = "road_1"
	if input.x ~= -output.x or input.y ~= -output.y then
		-- road_2 원본은 아래에서 들어와 오른쪽으로 나간다.
		if input.x == -output.y and input.y == output.x then
			texture = "road_2"
		else
			-- road_3 원본은 아래에서 들어와 왼쪽으로 나간다.
			texture = "road_3"
			rotation = (rotation + 180) % 360
		end
	end
	if self.TextureName ~= texture then
		self.ui_image:SetTexture(texture)
		self.ui_image:SetTiling(1,1)
		self.ui_image:SetOffset(0,0)
		-- 투명 여백을 포함한 원본 중심으로 회전해 코너의 연결 위치를 유지한다.
		self.ui_image:SetTextureSize(72,72)
		self.TextureName = texture
	end
	self.transform.rotation.z = rotation
	return true
end

---설치된 Grid 인덱스와 소속 RoadGroup을 저장합니다.
---@param x number 가로 칸 인덱스
---@param y number 세로 칸 인덱스
---@param group RoadGroup 소속된 길 묶음
function Script:Setting(x,y,group)
	self.GridX = x
	self.GridY = y
	self.RoadGroup = group
end

function Script:Update(DTime)


end

return Script
