local Script = {}

function Script:Spawn()
	self.transform = Transform.Add(self.ID)
	self.transform:SetParent(Grid.BoardID)
	self.ui_image = UIImage.Add(self.ID)
	self.ui_image:SetPivot(0.5,0.5)
	self.ui_image:SetOrder(1)
	self:SetDirection(0)
end

---출구의 Grid 인덱스를 저장하고 아이템 이미지를 설정합니다.
---@param x number 가로 Grid 인덱스
---@param y number 세로 Grid 인덱스
function Script:Setting(x,y)
	self.GridX = x
	self.GridY = y
	local item = ItemList[Grid[x][y].ItemIndex]
	local visual = {
		Texture = item.Texture,
		StartX = 192,
		StartY = 0,
		FrameWidth = 24,
		FrameHeight = 24,
		FrameCount = 8,
		AnimationSpeed = 1,
	}
	ItemVisual.Apply(self.ui_image,visual,18,18,true)
end

---출구의 입력 방향과 이미지 회전을 설정합니다. 0도는 왼쪽에서 받습니다.
---@param angle number 90도 단위 회전 각도
---@return boolean success 유효한 각도이면 true
function Script:SetDirection(angle)
	if type(angle) ~= "number" or angle % 90 ~= 0 then
		return false
	end
	self.Direction = angle % 360
	local inputs = {{-1,0},{0,-1},{1,0},{0,1}}
	local input = inputs[self.Direction / 90 + 1]
	self.Input = PVector2(input[1],input[2])
	self.transform.rotation.z = self.Direction
	return true
end

---BuildSystem의 시뮬레이션이 진행될 때만 도착한 자원을 회수합니다.
function Script:Tick(DTime)
	if not self.GridX or not self.GridY or DTime <= 0 then
		return
	end
	local x = self.GridX + self.Input.x
	local y = self.GridY + self.Input.y
	local cell = Grid[x] and Grid[x][y]
	local road = cell and cell.Script
	if not cell or cell.ItemIndex ~= 1 or not road or not road.OutPut then
		return
	end
	if road.OutPut.x ~= -self.Input.x or road.OutPut.y ~= -self.Input.y then
		return
	end
	local resource = RoadTransport.TakeOutput(x,y)
	if resource then
		self:OnReceive(resource)
	end
end

---자원 제거 후 추가 동작을 처리합니다. 삭제된 객체의 컴포넌트는 사용하지 않습니다.
---@param resource table 회수한 자원 데이터. ResourceIndex로 종류를 확인합니다.
function Script:OnReceive(resource)

end

return Script
