<UserControl x:Class="PixelTool.PVector2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PixelTool"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="0,2,0,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- 프로퍼티 이름 (예: Position, Offset) -->
        <TextBlock Text="{Binding LabelName, RelativeSource={RelativeSource AncestorType=UserControl}}" 
           Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0" Foreground="{DynamicResource PixelTextBrush}" TextAlignment="Center" />

        <!-- X 값 입력부 -->
        <TextBlock Text="X:" Grid.Column="1" VerticalAlignment="Center" Margin="5,0,2,0" Foreground="Red"/>
        <TextBox Text="{Binding XValue, ElementName=RootElement, UpdateSourceTrigger=PropertyChanged}" 
                 Grid.Column="2" VerticalAlignment="Center" Padding="2"
                 PreviewTextInput="NumberValidationTextBox" />

        <!-- Y 값 입력부 -->
        <TextBlock Text="Y:" Grid.Column="3" VerticalAlignment="Center" Margin="10,0,2,0" Foreground="Green"/>
        <TextBox Text="{Binding YValue, ElementName=RootElement, UpdateSourceTrigger=PropertyChanged}" 
                 Grid.Column="4" VerticalAlignment="Center" Padding="2"
                 PreviewTextInput="NumberValidationTextBox" />
    </Grid>
</UserControl>
