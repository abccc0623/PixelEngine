<UserControl x:Class="PixelTool.StringField" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="LabelColumn" Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Text="{Binding Label, ElementName=Root}" ToolTip="{Binding Label, ElementName=Root}" Margin="0,0,12,0"
   VerticalAlignment="Center" Foreground="{DynamicResource PixelTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
  <Border x:Name="InputBorder" Grid.Column="1" Width="{Binding InputWidth, ElementName=Root}" HorizontalAlignment="Left" Height="24" VerticalAlignment="Center" CornerRadius="3" BorderThickness="1" Background="{DynamicResource PixelBackgroundBrush}">
   <Border.Style><Style TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource PixelBorderBrush}"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Root}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PixelAccentBrush}"/></DataTrigger>
     <DataTrigger Binding="{Binding IsEnabled, ElementName=Root}" Value="False"><Setter Property="Opacity" Value="0.5"/></DataTrigger>
    </Style.Triggers>
   </Style></Border.Style>
   <TextBox x:Name="InputBox" Style="{x:Null}" Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    MaxLength="{Binding MaxLength, ElementName=Root}" Background="Transparent" Foreground="{DynamicResource PixelTextBrush}" CaretBrush="{DynamicResource PixelAccentBrush}"
    SelectionBrush="{DynamicResource PixelAccentMutedBrush}" BorderThickness="0" Padding="6,2" VerticalContentAlignment="Center" LostKeyboardFocus="InputFinished" KeyDown="InputKeyDown">
    <TextBox.Template><ControlTemplate TargetType="TextBox">
     <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
    </ControlTemplate></TextBox.Template>
   </TextBox>
  </Border>
 </Grid>
</UserControl>
