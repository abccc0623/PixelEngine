<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="FieldToggle" TargetType="ToggleButton">
  <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Border x:Name="Face" Background="{DynamicResource PixelBackgroundBrush}" CornerRadius="10" Padding="6,2">
    <Grid><Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource PixelMutedTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
     <TextBlock x:Name="State" Text="Off" Foreground="{DynamicResource PixelTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource PixelAccentMutedBrush}"/><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource PixelAccentBrush}"/><Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="State" Property="Text" Value="On"/><Setter TargetName="State" Property="HorizontalAlignment" Value="Left"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.85"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="FieldButton" TargetType="Button">
  <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Padding" Value="5,0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Face" Background="{DynamicResource PixelBackgroundBrush}" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource PixelSurfaceBrush}"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="FieldComboItem" TargetType="ComboBoxItem">
  <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
   <Border x:Name="Row" Background="{DynamicResource PixelPanelBrush}" Padding="8,6"><ContentPresenter/></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PixelSurfaceBrush}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PixelAccentMutedBrush}"/><Setter Property="Foreground" Value="{DynamicResource PixelAccentBrush}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="FieldCombo" TargetType="ComboBox">
  <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/><Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboItem}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
   <Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource PixelBackgroundBrush}"><Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource PixelTextBrush}" StrokeThickness="1.3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/></Border></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
     TextElement.Foreground="{DynamicResource PixelTextBrush}" Margin="6,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
     <Border Background="{DynamicResource PixelPanelBrush}" BorderBrush="{DynamicResource PixelBorderBrush}" BorderThickness="1" Padding="3" Margin="0,3,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
      <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
     </Border>
    </Popup>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <DrawingBrush x:Key="FieldChecker" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup>
  <GeometryDrawing Brush="{DynamicResource PixelBackgroundBrush}" Geometry="M0,0 H8 V8 H0 Z"/><GeometryDrawing Brush="{DynamicResource PixelSurfaceBrush}" Geometry="M0,0 H4 V4 H0 Z M4,4 H8 V8 H4 Z"/>
 </DrawingGroup></DrawingBrush.Drawing></DrawingBrush>
</ResourceDictionary>
