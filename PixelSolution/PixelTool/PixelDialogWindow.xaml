<Window x:Class="PixelTool.PixelDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource PixelTextBrush}">
    <Border Margin="10" Background="{DynamicResource PixelPanelBrush}"
            BorderBrush="{DynamicResource PixelBorderBrush}" BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="5" Opacity="0.45"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource PixelAccentBrush}" CornerRadius="12,12,0,0"/>

            <Grid Grid.Row="1" Margin="24,20,16,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="6"
                            Background="{DynamicResource PixelAccentMutedBrush}" Margin="0,0,12,0">
                        <TextBlock x:Name="IconText" Text="i" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PixelAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                        Width="28" Height="28" Padding="0" MinHeight="0"
                        Style="{DynamicResource PixelToolButton}" Click="Close_Click"/>
            </Grid>

            <StackPanel Grid.Row="2" Margin="66,18,24,22">
                <TextBlock x:Name="MessageText" Foreground="{DynamicResource PixelMutedTextBrush}"
                           FontSize="13" LineHeight="20" TextWrapping="Wrap"/>
                <TextBox x:Name="InputTextBox" Margin="0,18,0,0" MinHeight="42"
                         Style="{DynamicResource PixelTextBox}" FontSize="14"
                         Visibility="Collapsed" KeyDown="InputTextBox_KeyDown"/>
            </StackPanel>

            <Border Grid.Row="3" Background="{DynamicResource PixelBackgroundBrush}"
                    CornerRadius="0,0,12,12" Padding="20,14">
                <StackPanel x:Name="ButtonPanel" Orientation="Horizontal"
                            HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</Window>
