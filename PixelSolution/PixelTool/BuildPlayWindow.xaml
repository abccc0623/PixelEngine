<Window x:Class="PixelTool.BuildPlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build Play"
        Width="560" Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PixelBackgroundBrush}"
        Foreground="{DynamicResource PixelTextBrush}">
    <Border Margin="16" Padding="28"
            Background="{DynamicResource PixelPanelBrush}"
            BorderBrush="{DynamicResource PixelBorderBrush}"
            BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="BUILD PLAY"
                       Foreground="{DynamicResource PixelAccentBrush}"
                       FontSize="14" FontWeight="Bold"/>
            <TextBlock Grid.Row="1"
                       Text="Select where the client project will be saved."
                       Margin="0,9,0,0" FontSize="18" FontWeight="SemiBold"/>
            <StackPanel Grid.Row="2" Margin="0,18,0,22">
                <TextBlock Text="PREVIOUS PATH"
                           Foreground="{DynamicResource PixelMutedTextBrush}"
                           FontSize="11" FontWeight="SemiBold"/>
                <TextBlock x:Name="PreviousPathText"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource PixelMutedTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" MinHeight="46"
                        Style="{DynamicResource PixelToolButton}"
                        Content="새로운 경로로 저장"
                        Click="SaveToNewPath"/>
                <Button x:Name="PreviousPathButton"
                        Grid.Column="2" MinHeight="46"
                        Style="{DynamicResource PixelToolButton}"
                        Content="이전 경로로 저장"
                        Click="SaveToPreviousPath"/>
            </Grid>
        </Grid>
    </Border>
</Window>
