<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <BaseOutputPath>..\bin\</BaseOutputPath>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Editor_d</Configurations>
  </PropertyGroup>

 <PropertyGroup>
  <TargetFramework>net8.0-windows</TargetFramework>
  <Nullable>enable</Nullable>
  <ImplicitUsings>enable</ImplicitUsings>
  <OutputPath>..\bin\$(Configuration)\</OutputPath>
  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
</PropertyGroup>

 <ItemGroup>
   <None Remove="LuaCode\main.lua" />
   <None Remove="LuaCode\Module.lua" />
   <None Remove="LuaCode\Scene.lua" />
   <None Remove="LuaCode\Default.lua" />
   <None Remove="Tool\EditorLuaWindow\Lua.xshd" />
   <None Remove="Tool\LuaDark.xshd" />
 </ItemGroup>

 <ItemGroup>
   <EmbeddedResource Include="LuaCode\CreateCollider.lua">
     <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
   </EmbeddedResource>
   <EmbeddedResource Include="LuaCode\EventFunction.lua">
     <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
   </EmbeddedResource>
   <EmbeddedResource Include="LuaCode\BaseCamera.pxm">
     <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
   </EmbeddedResource>
   <EmbeddedResource Include="LuaCode\main.lua">
     <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
   </EmbeddedResource>
   <EmbeddedResource Include="LuaCode\Module.lua">
     <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
   </EmbeddedResource>
   <EmbeddedResource Include="LuaCode\Scene.lua">
     <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
   </EmbeddedResource>
   <EmbeddedResource Include="LuaCode\Default.lua">
     <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
   </EmbeddedResource>
 </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Protocol" Version="17.2.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="StreamJsonRpc" Version="2.24.84" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PixelEngine\PixelEngine.vcxproj" Condition="'$(InstallerPublish)' != 'true'" />
    <ProjectReference Include="..\PixelGraphics\PixelGraphics.vcxproj" Condition="'$(InstallerPublish)' != 'true'" />
  </ItemGroup>                       

  <ItemGroup>
    <EmbeddedResource Include="AI\AIRestrictions.md" LogicalName="PixelTool.AI.AIRestrictions.md" />
    <EmbeddedResource Include="AI\EditorGuide.md" LogicalName="PixelTool.AI.EditorGuide.md" />
    <EmbeddedResource Include="AI\LuaApiGuide.md" LogicalName="PixelTool.AI.LuaApiGuide.md" />
    <EmbeddedResource Include="Tool\EditorLuaWindow\Lua.xshd" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy &quot;$(ProjectDir)LSP\*.*&quot; &quot;$(TargetDir)LSP\&quot; /S /E /Y /I" />
  </Target>

  <Target Name="CreatePixelToolInstaller" AfterTargets="Build" DependsOnTargets="PostBuild"
          Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true' and '$(BuildInstaller)' != 'false'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Client\Client.vcxproj" Targets="Build"
             Properties="Configuration=Release;Platform=x64;SolutionDir=$(MSBuildProjectDirectory)\..\" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Installer\Build-Installer.ps1&quot; -SourceDir &quot;$(MSBuildProjectDirectory)\..\bin\$(Configuration)&quot; -OutputDir &quot;$(MSBuildProjectDirectory)\..\bin\Installer&quot; -CompilerPath &quot;$(InnoSetupCompilerPath)&quot;" />
  </Target>

</Project>
