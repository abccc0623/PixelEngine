<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <BaseOutputPath>..\bin\</BaseOutputPath>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Editor_d</Configurations>
  </PropertyGroup>

 <PropertyGroup>
  <TargetFramework>net8.0-windows</TargetFramework>
  <Nullable>enable</Nullable>
  <ImplicitUsings>enable</ImplicitUsings>
  <OutputPath>..\bin\$(Configuration)\</OutputPath>
  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
</PropertyGroup>

 <ItemGroup>
   <None Remove="LuaCode\main.lua" />
   <None Remove="LuaCode\Module.lua" />
   <None Remove="LuaCode\Scene.lua" />
   <None Remove="LuaCode\Default.lua" />
   <None Remove="Tool\EditorLuaWindow\Lua.xshd" />
   <None Remove="Tool\LuaDark.xshd" />
 </ItemGroup>

 <ItemGroup>
   <EmbeddedResource Include="LuaCode\CreateCollider.lua">
     <CopyToOutputDirectory>Never</CopyToOutputDirectory>
     <CopyToPublishDirectory>Never</CopyToPublishDirectory>
   </EmbeddedResource>
   <EmbeddedResource Include="LuaCode\EventFunction.lua">
     <CopyToOutputDirectory>Never</CopyToOutputDirectory>
     <CopyToPublishDirectory>Never</CopyToPublishDirectory>
   </EmbeddedResource>
   <EmbeddedResource Include="LuaCode\BaseCamera.pxm">
     <CopyToOutputDirectory>Never</CopyToOutputDirectory>
     <CopyToPublishDirectory>Never</CopyToPublishDirectory>
   </EmbeddedResource>
   <EmbeddedResource Include="LuaCode\main.lua">
     <CopyToOutputDirectory>Never</CopyToOutputDirectory>
     <CopyToPublishDirectory>Never</CopyToPublishDirectory>
   </EmbeddedResource>
   <EmbeddedResource Include="LuaCode\Module.lua">
     <CopyToOutputDirectory>Never</CopyToOutputDirectory>
     <CopyToPublishDirectory>Never</CopyToPublishDirectory>
   </EmbeddedResource>
   <EmbeddedResource Include="LuaCode\Scene.lua">
     <CopyToOutputDirectory>Never</CopyToOutputDirectory>
     <CopyToPublishDirectory>Never</CopyToPublishDirectory>
   </EmbeddedResource>
   <EmbeddedResource Include="LuaCode\Default.lua">
     <CopyToOutputDirectory>Never</CopyToOutputDirectory>
     <CopyToPublishDirectory>Never</CopyToPublishDirectory>
   </EmbeddedResource>
 </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Protocol" Version="17.2.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="StreamJsonRpc" Version="2.24.84" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PixelEngine\PixelEngine.vcxproj" Condition="'$(InstallerPublish)' != 'true'" />
    <ProjectReference Include="..\PixelGraphics\PixelGraphics.vcxproj" Condition="'$(InstallerPublish)' != 'true'" />
  </ItemGroup>                       

  <ItemGroup>
    <EmbeddedResource Include="LLMWiki\API\Docs\LuaConceptGuide.md" LogicalName="PixelTool.AI.LuaConceptGuide.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Component\Transform.md" LogicalName="PixelTool.AI.Doc/Component/Transform.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Component\Camera.md" LogicalName="PixelTool.AI.Doc/Component/Camera.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Component\Renderer2D.md" LogicalName="PixelTool.AI.Doc/Component/Renderer2D.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Component\Rigidbody2D.md" LogicalName="PixelTool.AI.Doc/Component/Rigidbody2D.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Component\Animation2D.md" LogicalName="PixelTool.AI.Doc/Component/Animation2D.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Component\UIImage.md" LogicalName="PixelTool.AI.Doc/Component/UIImage.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Component\UIText.md" LogicalName="PixelTool.AI.Doc/Component/UIText.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Component\UISilder.md" LogicalName="PixelTool.AI.Doc/Component/UISilder.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Other\Entity.md" LogicalName="PixelTool.AI.Doc/Other/Entity.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Other\Scene.md" LogicalName="PixelTool.AI.Doc/Other/Scene.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Other\Asset.md" LogicalName="PixelTool.AI.Doc/Other/Asset.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Other\Input.md" LogicalName="PixelTool.AI.Doc/Other/Input.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Other\Event.md" LogicalName="PixelTool.AI.Doc/Other/Event.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Other\Time.md" LogicalName="PixelTool.AI.Doc/Other/Time.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Other\Tween.md" LogicalName="PixelTool.AI.Doc/Other/Tween.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Other\Pool.md" LogicalName="PixelTool.AI.Doc/Other/Pool.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Other\Group.md" LogicalName="PixelTool.AI.Doc/Other/Group.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Other\PVector2.md" LogicalName="PixelTool.AI.Doc/Other/PVector2.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Other\PVector3.md" LogicalName="PixelTool.AI.Doc/Other/PVector3.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Other\Debug.md" LogicalName="PixelTool.AI.Doc/Other/Debug.md" />
    <EmbeddedResource Include="LLMWiki\API\Docs\Other\Engine.md" LogicalName="PixelTool.AI.Doc/Other/Engine.md" />
    <EmbeddedResource Include="Tool\EditorLuaWindow\Lua.xshd" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="LLMWiki\**\*.md;LLMWiki\**\*.txt;LLMWiki\**\*.lua">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy &quot;$(ProjectDir)LSP\*.*&quot; &quot;$(TargetDir)LSP\&quot; /S /E /Y /I" />
  </Target>

  <Target Name="CreatePixelToolInstaller" AfterTargets="Build" DependsOnTargets="PostBuild"
          Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true' and '$(BuildInstaller)' != 'false'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Client\Client.vcxproj" Targets="Build"
             Properties="Configuration=Release;Platform=x64;SolutionDir=$(MSBuildProjectDirectory)\..\" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Installer\Build-Installer.ps1&quot; -SourceDir &quot;$(MSBuildProjectDirectory)\..\bin\$(Configuration)&quot; -OutputDir &quot;$(MSBuildProjectDirectory)\..\bin\Installer&quot; -CompilerPath &quot;$(InnoSetupCompilerPath)&quot;" />
  </Target>

  <!-- Build ordering only: the art application is an independent executable. -->
  <ItemGroup><ProjectReference Include="..\PixelArtStudio\PixelArtStudio.csproj" ReferenceOutputAssembly="false" Private="false" /></ItemGroup>
</Project>
