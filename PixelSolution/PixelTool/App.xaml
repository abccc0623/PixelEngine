<Application x:Class="PixelTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PixelTool"
             xmlns:dock="https://github.com/Dirkster99/AvalonDock">
    <Application.Resources>
        <SolidColorBrush x:Key="PixelBackgroundBrush" Color="#202630"/>
        <SolidColorBrush x:Key="PixelPanelBrush" Color="#29323E"/>
        <SolidColorBrush x:Key="PixelSurfaceBrush" Color="#343F4D"/>
        <SolidColorBrush x:Key="PixelAccentBrush" Color="#FFD600"/>
        <SolidColorBrush x:Key="PixelAccentMutedBrush" Color="#544B16"/>
        <SolidColorBrush x:Key="PixelBorderBrush" Color="#3C4755"/>
        <SolidColorBrush x:Key="PixelTextBrush" Color="#E6EAF0"/>
        <SolidColorBrush x:Key="PixelMutedTextBrush" Color="#A7AFBA"/>
        <SolidColorBrush x:Key="PixelWhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PixelDockBorderBrush" Color="#323C49"/>

        <SolidColorBrush x:Key="PixelButtonBrush" Color="#242C36"/>
        <SolidColorBrush x:Key="PixelButtonHoverBrush" Color="#35404C"/>
        <SolidColorBrush x:Key="PixelButtonPressedBrush" Color="#FFD600"/>
        <SolidColorBrush x:Key="PixelButtonTextBrush" Color="#E1E1F0"/>
        <Color x:Key="PixelBackgroundColor">#202630</Color>
        <Color x:Key="PixelBorderColor">#3C4755</Color>

        <Style x:Key="PixelCompletionItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="3,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource PixelSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource PixelAccentMutedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PixelAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PixelCompletionToolTip" TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource PixelPanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PixelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MaxWidth" Value="540"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ContentPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PixelToolButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PixelButtonBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PixelButtonTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PixelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PixelButtonHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PixelAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PixelButtonPressedBrush}"/>
                                <Setter Property="Foreground" Value="#202630"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PixelAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1B222B"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#303844"/>
                                <Setter Property="Foreground" Value="#68717D"/>
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PixelIconButton" TargetType="Button" BasedOn="{StaticResource PixelToolButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="PixelFilterButton" TargetType="Button" BasedOn="{StaticResource PixelToolButton}">
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Padding" Value="9,4"/>
        </Style>

        <Style x:Key="PixelModeToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="Track"
                                    Grid.RowSpan="2"
                                    Background="{StaticResource PixelButtonBrush}"
                                    BorderBrush="{StaticResource PixelAccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="22"/>
                            <Border x:Name="Knob"
                                    Grid.RowSpan="2"
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,4,0,0"
                                    Background="{StaticResource PixelAccentBrush}"
                                    BorderBrush="{StaticResource PixelBackgroundBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"/>
                            <TextBlock x:Name="EditorText"
                                       Grid.Row="0"
                                       Text="Editor"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PixelBackgroundBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       IsHitTestVisible="False"/>
                            <TextBlock x:Name="PlayText"
                                       Grid.Row="1"
                                       Text="Play"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PixelMutedTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource PixelButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Knob" Property="Margin" Value="0,44,0,0"/>
                                <Setter TargetName="EditorText" Property="Foreground" Value="{StaticResource PixelMutedTextBrush}"/>
                                <Setter TargetName="PlayText" Property="Foreground" Value="{StaticResource PixelBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PixelTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PixelPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PixelTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PixelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource PixelSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PixelTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PixelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

    </Application.Resources>
</Application>
