<UserControl x:Class="PixelTool.AIChatWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource PixelToolButton}">
            <Setter Property="Background" Value="{DynamicResource PixelSurfaceBrush}"/>
            <Setter Property="Foreground" Value="#F2F5F9"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PixelBorderBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PixelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PixelBorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PixelAccentBrush}"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PixelPanelBrush}" Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="설정" Click="ToggleChatSettings"/>
                <Button x:Name="NewButton" Content="새 대화" Click="NewConversation" IsEnabled="False"/>
            </StackPanel>
            <TextBlock Text="AI 자비스" Foreground="{DynamicResource PixelAccentBrush}" FontWeight="Bold" Margin="6" VerticalAlignment="Center"/>
            <TextBlock x:Name="AccountSummary" Text="계정 연결 필요" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Foreground="{DynamicResource PixelMutedTextBrush}" Margin="6"/>
        </DockPanel>
        <DockPanel Grid.Row="1">
          <TextBlock x:Name="ElapsedTimeText" DockPanel.Dock="Right" Visibility="Collapsed"
                     Foreground="{DynamicResource PixelAccentBrush}" FontSize="11" Margin="6,2"
                     VerticalAlignment="Center" ToolTip="요청 전송부터 완료까지의 시간입니다. 사용자 답변·승인 대기 시간도 포함합니다."/>
          <TextBlock x:Name="StatusText" Text="연결되지 않음 · 설정에서 ChatGPT 계정을 연결하세요."
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                   Foreground="{DynamicResource PixelMutedTextBrush}" FontSize="11" Margin="6,2"/>
        </DockPanel>
        <Border x:Name="SettingsPanel" Grid.Row="2" Grid.RowSpan="4" Panel.ZIndex="10" VerticalAlignment="Top"
                Visibility="Collapsed" MaxHeight="280" Padding="8" Margin="0,4" BorderThickness="1" CornerRadius="4"
                Background="{DynamicResource PixelPanelBrush}" BorderBrush="{DynamicResource PixelAccentBrush}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
           <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="닫기" Click="ToggleChatSettings"/>
                <Button Content="계정 관리" Click="ToggleAccountDetails" HorizontalAlignment="Left"/>
            </DockPanel>
          <StackPanel x:Name="AccountDetails">
            <WrapPanel>
                <Button x:Name="ConnectButton" Content="Continue with ChatGPT" Click="Connect"/>
                <Button x:Name="InstallCliButton" Content="Codex CLI 설치" Click="InstallCli"/>
                <Button x:Name="AddAccountButton" Content="다른 계정 추가" Click="AddAccount" IsEnabled="False"/>
                <Button x:Name="ReauthorizeButton" Content="계정 재인증" Click="Reauthorize" IsEnabled="False"/>
                <Button x:Name="RefreshButton" Content="로그인 확인" Click="RefreshAccount" IsEnabled="False"/>
            </WrapPanel>
            <DockPanel Margin="6,3">
                <TextBlock Text="계정" Foreground="{DynamicResource PixelTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="AccountBox" DisplayMemberPath="Label" SelectionChanged="AccountChanged" MinWidth="160" IsEnabled="False"/>
            </DockPanel>
          </StackPanel>
            <DockPanel Margin="6,3">
                <TextBlock Text="매니저 모델" Foreground="{DynamicResource PixelTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ModelBox" IsEnabled="False" MinWidth="160" DisplayMemberPath="DisplayName"
                          SelectionChanged="ModelChanged" ToolTip="현재 ChatGPT 계정이 제공하는 모델 목록입니다. 변경은 다음 메시지부터 적용됩니다."/>
            </DockPanel>
            <DockPanel Margin="6,3">
                <TextBlock Text="프로그래머 모델" Foreground="{DynamicResource PixelTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ProgrammerModelBox" IsEnabled="False" MinWidth="160" DisplayMemberPath="DisplayName"
                          SelectionChanged="ProgrammerModelChanged" ToolTip="코드 분석·수정을 맡는 프로그래머의 독립 모델입니다. 다음 요청부터 적용됩니다."/>
            </DockPanel>
            <DockPanel Margin="6,3">
                <TextBlock Text="프로그래머 추론" Foreground="{DynamicResource PixelTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ProgrammerEffortBox" IsEnabled="False" MinWidth="160"
                          SelectionChanged="ProgrammerEffortChanged" ToolTip="선택한 모델이 제공하는 추론 강도입니다."/>
            </DockPanel>
            <TextBlock x:Name="ProgrammerModelWarning" Visibility="Collapsed" TextWrapping="Wrap" Margin="6,3"
                       Foreground="{DynamicResource PixelAccentBrush}"/>
            <CheckBox x:Name="RequirePlan" Content="이번 요청은 계획 승인 후 작업" Foreground="{DynamicResource PixelTextBrush}" Margin="6"
                      ToolTip="켜면 간단 작업도 계획 승인 전에는 변경할 수 없습니다. 큰 작업·선택적 조사/검토 작업은 계획 승인이 필요하며, 일반 프로그래머 작업은 기존 승인 설정을 따릅니다."/>
            <CheckBox x:Name="AllowEdits" Content="프로젝트 파일 수정 허용" Foreground="{DynamicResource PixelTextBrush}" Margin="6"
                      Checked="AllowEditsChanged" Unchecked="AllowEditsChanged"/>
            <DockPanel Margin="6,3">
                <TextBlock Text="작업 승인" Foreground="{DynamicResource PixelTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CommandApprovalBox" SelectionChanged="CommandApprovalChanged" MinWidth="170"
                          ToolTip="언제든 변경할 수 있습니다. 변경한 설정은 다음 메시지부터 적용됩니다.">
                    <ComboBoxItem Content="항상 확인 요청"/>
                    <ComboBoxItem Content="일반 작업 자동 승인"/>
                </ComboBox>
            </DockPanel>
            <TextBlock Text="자동 승인에서는 요청에 필요한 조회·파일 수정·Asset 파일 및 폴더 생성·이동·삭제를 다시 묻지 않습니다. 변경에는 ‘프로젝트 파일 수정 허용’이 필요합니다. 설치·커밋·푸시는 별도 확인 대상입니다."
                       TextWrapping="Wrap" Foreground="{DynamicResource PixelMutedTextBrush}" FontSize="11" Margin="6,0,6,6"/>
            <TextBlock Text="수정 허용 전에는 읽기 전용입니다. 수정할 파일은 먼저 저장하세요. API 키 로그인은 사용하지 않습니다." TextWrapping="Wrap" Foreground="{DynamicResource PixelMutedTextBrush}" FontSize="11" Margin="6,0,6,6"/>
            <TextBlock Text="직접 연결: 코드·에셋·Asset 파일 및 폴더 생성·이동·휴지통 삭제·리임포트·로그 조회 지원. 리임포트는 실행 상태를 초기화합니다. 임의 명령·빌드는 지원하지 않습니다."
                       TextWrapping="Wrap" Foreground="{DynamicResource PixelMutedTextBrush}" FontSize="11" Margin="6,0,6,6"/>
           </StackPanel>
          </ScrollViewer>
        </Border>
        <TextBlock x:Name="UsageText" Grid.Row="2" Margin="6,2" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource PixelMutedTextBrush}" Text="토큰 사용량 수신 대기 · 청구 비용은 표시하지 않음"
                   ToolTip="이번 요청은 메인과 보조 작업의 사용량을 합산합니다. 입력에 캐시가, 출력에 추론 토큰이 포함되므로 중복 합산하지 않습니다. 메인 대화 누적은 별도이며 컨텍스트 점유와 다릅니다. 누락되거나 불완전한 사용량은 0으로 계산하지 않고, 청구 비용을 추정하지 않습니다."/>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="ActivityBanner" Padding="8,6" Margin="0,2,0,4" CornerRadius="4" BorderThickness="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Background" Value="{DynamicResource PixelSurfaceBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource PixelBorderBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=StopButton}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Background" Value="#382F18"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PixelAccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="Bold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="대기 중 · 진행 중인 응답 없음"/>
                                <Setter Property="Foreground" Value="{DynamicResource PixelMutedTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=StopButton}" Value="True">
                                        <Setter Property="Text" Value="AI 자비스 응답 중 · 생각하거나 작업하고 있습니다"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PixelAccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=ChoicePanel}" Value="Visible">
                                        <Setter Property="Text" Value="답변 대기 중 · 아래 선택지를 클릭해 주세요"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar x:Name="ResponseProgress" Height="5" Margin="0,9,0,0"
                                 IsIndeterminate="{Binding IsEnabled, ElementName=StopButton}"
                                 Foreground="{DynamicResource PixelAccentBrush}" Background="#211E17"
                                 AutomationProperties.Name="AI 자비스 응답 진행 중">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=StopButton}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=ChoicePanel}" Value="Visible">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>
            <ListBox x:Name="TranscriptBox" Grid.Row="1"
                     Background="{DynamicResource PixelBackgroundBrush}" Foreground="{DynamicResource PixelTextBrush}"
                     BorderBrush="{DynamicResource PixelBorderBrush}"
                     ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" PreviewKeyDown="TranscriptKeyDown">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="TranscriptScrollHost" CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="선택 영역 복사" Command="Copy"/>
                        <MenuItem Header="대화 전체 복사" InputGestureText="Ctrl+Shift+C" Click="CopyTranscript"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <!-- Avoid character-by-character wrapping at transient narrow docking widths. -->
                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False"
                                 ContextMenu="{Binding ContextMenu, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                 MinWidth="160" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent" BorderThickness="0" Padding="8">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCodeChange}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="Foreground" Value="#9AD0FF"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNotice}" Value="True">
                                            <Setter Property="Foreground" Value="#FFCA80"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Expander Header="{Binding Header}" IsExpanded="False" Margin="8,0"
                                  Foreground="{DynamicResource PixelMutedTextBrush}">
                            <Expander.Style>
                                <Style TargetType="Expander">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCodeChange}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Expander.Style>
                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False"
                                     FontFamily="Consolas" MaxHeight="360" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     ContextMenu="{Binding ContextMenu, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"/>
                        </Expander>
                        <Expander Header="승인 범위·제약·검증 상세 보기" IsExpanded="False" Margin="8,0"
                                  Foreground="{DynamicResource PixelMutedTextBrush}">
                            <Expander.Style>
                                <Style TargetType="Expander">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDetails}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Expander.Style>
                            <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False"
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="360"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                        </Expander>
                      </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border x:Name="ChoicePanel" Grid.Row="2" Visibility="Collapsed" Padding="10" Margin="0,6,0,0"
                    MaxHeight="260" BorderThickness="1" CornerRadius="4"
                    Background="{DynamicResource PixelSurfaceBrush}" BorderBrush="{DynamicResource PixelAccentBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="ChoiceQuestion" TextWrapping="Wrap" FontWeight="Bold"
                                   Foreground="{DynamicResource PixelTextBrush}" Margin="0,0,0,6"/>
                        <Expander x:Name="ChoiceDetails" Header="승인 범위·제약·검증 상세 보기"
                                  IsExpanded="False" Visibility="Collapsed" Margin="0,0,0,6"
                                  Foreground="{DynamicResource PixelMutedTextBrush}">
                            <TextBox x:Name="ChoiceDetailsText" IsReadOnly="True" IsUndoEnabled="False"
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                        </Expander>
                        <ItemsControl x:Name="ChoiceOptions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="ChooseOption" HorizontalContentAlignment="Left" Padding="10,7">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="답변 보내기" Click="SubmitCustomChoice"/>
                            <TextBox x:Name="ChoiceCustomText" MaxLength="2000" TextWrapping="Wrap" MinHeight="32"
                                     ToolTip="선택지 대신 직접 답변할 수도 있습니다."/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBox x:Name="PromptBox" Grid.Row="4" Margin="0,6,0,0" MinHeight="56" MaxHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" PreviewKeyDown="PromptKeyDown" ToolTip="Ctrl+Enter: 전송"
                 IsReadOnly="{Binding IsEnabled, ElementName=StopButton}"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="StopButton" Content="요청 중지" Click="Stop" IsEnabled="False"
                    AutomationProperties.Name="현재 AI 요청 중지"
                    ToolTip="진행 중인 요청과 보조 작업을 중지합니다. 이미 수행한 변경은 되돌리지 않습니다."/>
            <Button x:Name="SendButton" Content="전송 (Ctrl+Enter)" Click="Send" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</UserControl>
