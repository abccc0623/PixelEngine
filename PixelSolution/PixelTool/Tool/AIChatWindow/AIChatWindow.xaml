<UserControl x:Class="PixelTool.AIChatWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PixelSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PixelBorderBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PixelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PixelBorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PixelAccentBrush}"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PixelPanelBrush}" Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="계정 관리" Click="ToggleAccountDetails"/>
                <Button x:Name="NewButton" Content="새 대화" Click="NewConversation" IsEnabled="False"/>
            </StackPanel>
            <TextBlock Text="CHATGPT" Foreground="{DynamicResource PixelAccentBrush}" FontWeight="Bold" Margin="6" VerticalAlignment="Center"/>
            <TextBlock x:Name="AccountSummary" Text="계정 연결 필요" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource PixelMutedTextBrush}" Margin="6"/>
        </DockPanel>
        <TextBlock Grid.Row="1" Text="ChatGPT 계정으로 직접 연결 · Codex 설치 및 API 키 불필요"
                   TextWrapping="Wrap" Foreground="{DynamicResource PixelMutedTextBrush}" Margin="6"/>
        <StackPanel Grid.Row="2">
          <StackPanel x:Name="AccountDetails">
            <WrapPanel>
                <Button x:Name="ConnectButton" Content="Continue with ChatGPT" Click="Connect"/>
                <Button x:Name="AddAccountButton" Content="다른 계정 추가" Click="AddAccount" IsEnabled="False"/>
                <Button x:Name="ReauthorizeButton" Content="계정 재인증" Click="Reauthorize" IsEnabled="False"/>
                <Button x:Name="RefreshButton" Content="로그인 확인" Click="RefreshAccount" IsEnabled="False"/>
            </WrapPanel>
            <DockPanel Margin="6,3">
                <TextBlock Text="계정" Foreground="{DynamicResource PixelTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="AccountBox" DisplayMemberPath="Label" SelectionChanged="AccountChanged" MinWidth="160" IsEnabled="False"/>
            </DockPanel>
          </StackPanel>
            <DockPanel Margin="6,3">
                <TextBlock Text="모델" Foreground="{DynamicResource PixelTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ModelBox" IsEnabled="False" MinWidth="160" DisplayMemberPath="DisplayName"
                          SelectionChanged="ModelChanged" ToolTip="현재 ChatGPT 계정이 제공하는 모델 목록입니다. 변경은 다음 메시지부터 적용됩니다."/>
            </DockPanel>
            <TextBlock x:Name="StatusText" Text="연결되지 않음 · ChatGPT 계정으로 로그인하세요." TextWrapping="Wrap" Foreground="{DynamicResource PixelMutedTextBrush}" Margin="6"/>
            <CheckBox x:Name="AllowEdits" Content="프로젝트 파일 수정 허용" Foreground="{DynamicResource PixelTextBrush}" Margin="6"
                      Checked="AllowEditsChanged" Unchecked="AllowEditsChanged"/>
            <DockPanel Margin="6,3">
                <TextBlock Text="작업 승인" Foreground="{DynamicResource PixelTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CommandApprovalBox" SelectionChanged="CommandApprovalChanged" MinWidth="170"
                          ToolTip="언제든 변경할 수 있습니다. 변경한 설정은 다음 메시지부터 적용됩니다.">
                    <ComboBoxItem Content="항상 확인 요청"/>
                    <ComboBoxItem Content="일반 작업 자동 승인"/>
                </ComboBox>
            </DockPanel>
            <TextBlock Text="자동 승인에서는 요청에 필요한 조회·일반 파일 생성·수정을 다시 묻지 않습니다. 파일 변경에는 ‘프로젝트 파일 수정 허용’이 필요합니다. 삭제·설치·커밋·푸시는 별도 확인 대상입니다."
                       TextWrapping="Wrap" Foreground="{DynamicResource PixelMutedTextBrush}" FontSize="11" Margin="6,0,6,6"/>
            <TextBlock Text="수정 허용 전에는 읽기 전용입니다. 수정할 파일은 먼저 저장하세요. API 키 로그인은 사용하지 않습니다." TextWrapping="Wrap" Foreground="{DynamicResource PixelMutedTextBrush}" FontSize="11" Margin="6,0,6,6"/>
            <TextBlock Text="직접 연결: 코드·에셋·리임포트·로그 조회 지원. 리임포트는 현재 실행 상태를 초기화합니다. 임의 명령·삭제·빌드는 지원하지 않습니다."
                       TextWrapping="Wrap" Foreground="{DynamicResource PixelMutedTextBrush}" FontSize="11" Margin="6,0,6,6"/>
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="ActivityBanner" Padding="12,10" Margin="0,4,0,6" CornerRadius="4" BorderThickness="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource PixelSurfaceBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource PixelBorderBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=StopButton}" Value="True">
                                <Setter Property="Background" Value="#382F18"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PixelAccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="Bold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="대기 중 · 진행 중인 응답 없음"/>
                                <Setter Property="Foreground" Value="{DynamicResource PixelMutedTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=StopButton}" Value="True">
                                        <Setter Property="Text" Value="AI 응답 중 · 생각하거나 작업하고 있습니다"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PixelAccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar x:Name="ResponseProgress" Height="5" Margin="0,9,0,0"
                                 IsIndeterminate="{Binding IsEnabled, ElementName=StopButton}"
                                 Foreground="{DynamicResource PixelAccentBrush}" Background="#211E17"
                                 AutomationProperties.Name="AI 응답 진행 중">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=StopButton}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>
            <TextBox x:Name="TranscriptBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </Grid>
        <TextBox x:Name="PromptBox" Grid.Row="4" Margin="0,6,0,0" MinHeight="75" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" PreviewKeyDown="PromptKeyDown" ToolTip="Ctrl+Enter: 전송"
                 IsReadOnly="{Binding IsEnabled, ElementName=StopButton}"/>
        <DockPanel Grid.Row="5">
            <Button x:Name="StopButton" Content="응답 중지" Click="Stop" IsEnabled="False"/>
            <Button x:Name="SendButton" Content="전송 (Ctrl+Enter)" Click="Send" IsEnabled="False" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</UserControl>
