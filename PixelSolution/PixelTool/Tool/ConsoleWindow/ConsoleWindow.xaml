<UserControl x:Class="PixelTool.ConsoleWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PixelTool"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Background="{StaticResource PixelBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Content="🧹" Grid.Column="0" Click="Clear"></Button>
        </Grid>
        
        <ListBox x:Name="EngineLogView" Grid.Row="1" Background="{StaticResource PixelBackgroundBrush}" Foreground="{StaticResource PixelTextBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="8,0,0,0"
                                   Foreground="{Binding DisplayColor, Mode=OneWay}"
                                   Text="{Binding CountText, Mode=OneWay}" />
                        <TextBlock Foreground="{Binding DisplayColor, Mode=OneWay}">
                            <Run Text="[" />
                            <Run Text="{Binding Timestamp, Mode=OneWay}" />
                            <Run Text="]" />
                            <Run Text="{Binding Tag, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding Message, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="복사 (Copy)" Click="CopyMenuItem_Click" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </Grid>
</UserControl>
