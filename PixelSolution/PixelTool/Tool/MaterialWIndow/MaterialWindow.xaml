<UserControl x:Class="PixelTool.MaterialWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PixelTool"
             xmlns:dock="https://github.com/Dirkster99/AvalonDock"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="500">
    <Grid Background="{DynamicResource PixelBackgroundBrush}" >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0" Text="File Name" Foreground="{DynamicResource PixelTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Grid.Row="0" Margin="5,15,5,15" Name="FileName"/>

            <TextBlock Grid.Column="0" Grid.Row="1" Text="Texture" Foreground="{DynamicResource PixelTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Grid.Row="1" Margin="5,15,5,15" IsReadOnly="True" Name="TexturePath"/>
            <Button Grid.Column="2" Grid.Row="1" Margin="10" Content="📂" Click="FindTextureButton"/>

            <TextBlock Grid.Column="0" Grid.Row="2" Text="Offset" Foreground="{DynamicResource PixelTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Grid Grid.Column="1" Grid.Row="2" Margin="5,15,5,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock  Grid.Column  ="0" Text="X" Foreground="{DynamicResource PixelTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <TextBox    Grid.Column  ="1" Name="OffsetX" LostFocus ="OffsetXChange"></TextBox>
                <TextBlock  Grid.Column  ="2" Text="Y" Foreground="{DynamicResource PixelTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <TextBox    Grid.Column  ="3" Name="OffsetY" LostFocus ="OffsetYChange"></TextBox>
            </Grid>


            <TextBlock Grid.Column="0" Grid.Row="3" Text="Tiling" Foreground="{DynamicResource PixelTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Grid Grid.Column="1" Grid.Row="3" Margin="5,15,5,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock  Grid.Column  ="0" Text="X" Foreground="{DynamicResource PixelTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <TextBox    Grid.Column  ="1" Name="TilingX" LostFocus ="TilingXChange"></TextBox>
                <TextBlock  Grid.Column  ="2" Text="Y" Foreground="{DynamicResource PixelTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <TextBox    Grid.Column  ="3" Name="TilingY" LostFocus ="TilingYChange"></TextBox>
            </Grid>
        </Grid>

        <Rectangle Grid.Row="1" Width="250" Height="250" Stroke="DarkGray" StrokeThickness="1">
            <Rectangle.Fill>
                <ImageBrush x:Name="PreviewBrush" 
                    TileMode="Tile" 
                    Stretch="Fill" 
                    ViewportUnits="RelativeToBoundingBox" />
            </Rectangle.Fill>
        </Rectangle>

        <Grid Grid.Row="2" Margin="10">
            <Button Grid.Column="0" Margin="5,0,5,0" Content="생성" Click="CreateButton"></Button>
        </Grid>

    </Grid>
</UserControl>
