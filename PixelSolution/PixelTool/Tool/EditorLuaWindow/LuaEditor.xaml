<UserControl x:Class="PixelTool.LuaEditorWindow"
             xmlns:cc="clr-namespace:ICSharpCode.AvalonEdit.CodeCompletion;assembly=ICSharpCode.AvalonEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PixelTool"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource PixelPanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="EditorChange" Grid.Column="0" Margin="10,0,8,0" VerticalAlignment="Center"
                       Foreground="#63C174" FontSize="11" Text="● Saved"/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource PixelMutedTextBrush}"
                       FontSize="11" Text="Lua 5.1  •  Ctrl+K, D to format"/>
            <Button Grid.Column="2" Margin="0,3,4,3" Style="{StaticResource PixelIconButton}"
                    Content="" ToolTip="Save changes (Ctrl+S)" Click="SaveLuaFile"/>
            <Button Grid.Column="3" Margin="0,3,6,3" Style="{StaticResource PixelIconButton}"
                    Content="" ToolTip="Save and reload assets (Ctrl+R)" Click="ReimportLuaFile"/>
        </Grid>

        <avalonEdit:TextEditor 
            x:Name="LuaEditor"
            FontFamily="Consolas"
            FontSize="13pt"
            ShowLineNumbers="True"
            Background="#202630"
            Foreground="#D8DCE8"
            PreviewKeyDown="luaEditor_PreviewKeyDown"
            Grid.Row="1">
            <avalonedit:TextEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Create Event" IsCheckable= "False">
                        <MenuItem Header="OnCollisionEnter" Tag="Event_KeyUp" Click="Create_CollisionEnter"/>
                        <MenuItem Header="OnCollisionExit" Tag="Event_KeyUp" Click="Create_CollisionExit"/>
                    </MenuItem>

                    <Separator />
                </ContextMenu>
            </avalonedit:TextEditor.ContextMenu>

            <avalonEdit:TextEditor.InputBindings>
                <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/>
            </avalonEdit:TextEditor.InputBindings>

        </avalonEdit:TextEditor>
    </Grid>
</UserControl>
