<UserControl x:Class="PixelTool.LuaEditorWindow"
             xmlns:cc="clr-namespace:ICSharpCode.AvalonEdit.CodeCompletion;assembly=ICSharpCode.AvalonEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PixelTool"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="LuaEditorContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource PixelSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PixelTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PixelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LuaEditorMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PixelTextBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"/>
                                    <Path x:Name="SubmenuArrow" Grid.Column="1"
                                          Margin="18,0,2,0"
                                          VerticalAlignment="Center"
                                          Fill="{TemplateBinding Foreground}"
                                          Data="M 0 0 L 4 4 L 0 8 Z"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   HorizontalOffset="-2"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource PixelSurfaceBrush}"
                                        BorderBrush="{StaticResource PixelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PixelAccentMutedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PixelAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LuaEditorSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource PixelBorderBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderThickness="2">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#394354"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="BorderBrush" Value="#65B9FF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TabControl x:Name="FileTabs" Grid.Row="0" SelectionChanged="FileTabs_SelectionChanged"
                    Background="#202630" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#A8B3C5"/>
                    <Setter Property="Background" Value="#1B2029"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent" BorderThickness="0,3,0,0" Margin="0,0,2,0">
                                    <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#303C4E"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#254A70"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#65B9FF"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabControl.ContentTemplate><DataTemplate><Border Height="0"/></DataTemplate></TabControl.ContentTemplate>
        </TabControl>
        <Grid Grid.Row="1" Background="{StaticResource PixelPanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="EditorChange" Grid.Column="0" Margin="10,0,8,0" VerticalAlignment="Center"
                       Foreground="#63C174" FontSize="11" Text="● Saved"/>
            <Button x:Name="DebugToggle" Grid.Column="1" HorizontalAlignment="Left" Margin="0,3,6,3"
                    Padding="8,0" Click="ToggleDebugging" FontSize="11"
                    ToolTip="줄 번호 왼쪽 클릭 또는 F9로 중단점 설정. Play 중 실행되는 Lua에서 멈춥니다. F5: 계속, F11: 다음 줄 진입."/>
            <Button Grid.Column="2" Margin="0,3,4,3" Style="{StaticResource PixelIconButton}"
                    Content="" ToolTip="Save changes (Ctrl+S)" Click="SaveLuaFile"/>
            <Button Grid.Column="3" Margin="0,3,6,3" Style="{StaticResource PixelIconButton}"
                    Content="" ToolTip="Save and reload assets (Ctrl+R)" Click="ReimportLuaFile"/>
        </Grid>

        <avalonEdit:TextEditor 
            x:Name="LuaEditor"
            FontFamily="Consolas"
            FontSize="13pt"
            ShowLineNumbers="True"
            Background="#202630"
            Foreground="#D8DCE8"
            PreviewKeyDown="luaEditor_PreviewKeyDown"
            Grid.Row="2">
            <avalonedit:TextEditor.ContextMenu>
                <ContextMenu Style="{StaticResource LuaEditorContextMenuStyle}">
                    <MenuItem Header="Create Event" Style="{StaticResource LuaEditorMenuItemStyle}">
                        <MenuItem Header="OnCollisionEnter" Style="{StaticResource LuaEditorMenuItemStyle}" Click="Create_CollisionEnter"/>
                        <MenuItem Header="OnCollisionExit" Style="{StaticResource LuaEditorMenuItemStyle}" Click="Create_CollisionExit"/>
                        <MenuItem Header="OnAnimationCallBack" Style="{StaticResource LuaEditorMenuItemStyle}" Click="Create_AnimationCallBack"/>
                    </MenuItem>

                    <MenuItem Header="Create Coroutine" Style="{StaticResource LuaEditorMenuItemStyle}">
                        <MenuItem Header="WaitForSeconds" Style="{StaticResource LuaEditorMenuItemStyle}" Click="Create_WaitForSeconds"/>
                    </MenuItem>

                    <Separator Style="{StaticResource LuaEditorSeparatorStyle}"/>
                </ContextMenu>
            </avalonedit:TextEditor.ContextMenu>

            <avalonEdit:TextEditor.InputBindings>
                <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/>
            </avalonEdit:TextEditor.InputBindings>

        </avalonEdit:TextEditor>
    </Grid>
    </Border>
</UserControl>
