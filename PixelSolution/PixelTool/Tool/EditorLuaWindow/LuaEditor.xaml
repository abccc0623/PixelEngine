<UserControl x:Class="PixelTool.LuaEditorWindow"
             xmlns:cc="clr-namespace:ICSharpCode.AvalonEdit.CodeCompletion;assembly=ICSharpCode.AvalonEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PixelTool"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource PixelBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="EditorChange" Width="20" Grid.Column="0" Foreground="Green">🔴</TextBlock>
            <Button Width="20" Grid.Column="1" Foreground="Black" ToolTip="Save changes to file (Ctrl+S)" Click="SaveLuaFile">💾</Button>
            <Button Width="20" Grid.Column="2" Foreground="Black" ToolTip="Reload assets from source (Ctrl+R)" Click="ReimportLuaFile">🔄</Button>
        </Grid>
        
        <avalonEdit:TextEditor 
            x:Name="LuaEditor"
            FontFamily="Consolas"
            FontSize="12pt"
            ShowLineNumbers="True"
            Background="#1E1E1E" 
            Foreground="#DCDCDC"
            PreviewKeyDown="luaEditor_PreviewKeyDown"
            Grid.Row="1">
            <avalonedit:TextEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Create Event" IsCheckable= "False">
                        <MenuItem Header="CustomEvent" Tag="CustomEvent" Click="CustomEvent"/>
                        <MenuItem Header="KeyDown" Tag="Event_KeyDown" Click="Event_KeyDown"/>
                        <MenuItem Header="KeyUp" Tag="Event_KeyUp" Click="Event_KeyUp"/>
                    </MenuItem>
                    <Separator />
                </ContextMenu>
            </avalonedit:TextEditor.ContextMenu>

            <avalonEdit:TextEditor.InputBindings>
                <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/>
            </avalonEdit:TextEditor.InputBindings>

        </avalonEdit:TextEditor>
    </Grid>
</UserControl>
