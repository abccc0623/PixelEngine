<UserControl x:Class="PixelTool.ArtStudio"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PixelTool"
 Background="{DynamicResource PixelBackgroundBrush}">
 <UserControl.Resources>
  <ResourceDictionary>
  <ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="../../Custom/Fields/FieldStyles.xaml"/>
   <ResourceDictionary Source="../../Custom/EditorScrollStyles.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource PixelScrollBar}"/>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource FieldButton}">
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Padding" Value="12,6"/>
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="CustomText" TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource PixelBackgroundBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource PixelAccentBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource PixelBorderBrush}"/>
   <Setter Property="SelectionBrush" Value="{DynamicResource PixelAccentMutedBrush}"/>
   <Setter Property="Padding" Value="8"/>
   <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PixelAccentBrush}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Panel" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource PixelPanelBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource PixelBorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="18"/>
  </Style>
  <Style x:Key="ModeButton" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/>
   <Setter Property="Background" Value="{DynamicResource PixelBackgroundBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource PixelBorderBrush}"/>
   <Setter Property="Margin" Value="0,0,0,6"/>
   <Setter Property="Height" Value="36"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,4">
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Ellipse x:Name="SelectedDot" Width="7" Height="7" Fill="{DynamicResource PixelAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Hidden"/>
        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
       </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource PixelSurfaceBrush}"/></Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="SelectedDot" Property="Visibility" Value="Visible"/>
        <Setter TargetName="Face" Property="Background" Value="{DynamicResource PixelAccentMutedBrush}"/>
        <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource PixelAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PixelAccentBrush}"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource PixelAccentBrush}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.6"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ResourceTabs" TargetType="ListBox">
   <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBox">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
       <ScrollViewer Focusable="False" CanContentScroll="True" Padding="{TemplateBinding Padding}">
        <ItemsPresenter/>
       </ScrollViewer>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource PixelTextBrush}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Margin" Value="0,0,0,5"/>
   <Setter Property="Height" Value="36"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Face" Background="{DynamicResource PixelBackgroundBrush}" BorderBrush="{DynamicResource PixelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,5">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Ellipse x:Name="SelectedDot" Width="7" Height="7" Fill="{DynamicResource PixelAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Hidden"/>
        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource PixelSurfaceBrush}"/></Trigger>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="SelectedDot" Property="Visibility" Value="Visible"/>
        <Setter TargetName="Face" Property="Background" Value="{DynamicResource PixelAccentMutedBrush}"/>
        <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource PixelAccentBrush}"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource PixelAccentBrush}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="16">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="0.4*" MinWidth="72" MaxWidth="132"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.65*" MinWidth="104" MaxWidth="218"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Panel}">
     <StackPanel>
      <RadioButton x:Name="Mode2D" GroupName="ArtDimension" Content="2D" IsChecked="True" FontWeight="SemiBold" Style="{StaticResource ModeButton}" Checked="ModeChanged"/>
      <RadioButton x:Name="Mode3D" GroupName="ArtDimension" Content="3D" FontWeight="SemiBold" Style="{StaticResource ModeButton}" Checked="ModeChanged"/>
     </StackPanel>
    </Border>
    <Border x:Name="CategoryPanel" Grid.Column="2" Style="{StaticResource Panel}" Visibility="Collapsed">
      <ListBox x:Name="ResourceList" Style="{StaticResource ResourceTabs}" Background="Transparent" BorderThickness="0" SelectionChanged="ResourceChanged"
       ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
       <ListBox.ItemTemplate><DataTemplate>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Border x:Name="DetailsPanel" Grid.Column="4" Style="{StaticResource Panel}" Visibility="Collapsed">
     <ScrollViewer x:Name="FieldsScroll" Style="{StaticResource PixelScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
     <StackPanel x:Name="CreationFields" MinWidth="524" Width="{Binding ViewportWidth, ElementName=FieldsScroll}" Visibility="Collapsed">
      <Grid x:Name="ImageNameRow" Margin="0,0,0,14" Visibility="Collapsed">
       <local:StringField x:Name="ImageNameInput" Label="이미지 이름" Text="default.png" MaxLength="160" TextCommitted="ImageNameFinished"/>
      </Grid>
      <Grid x:Name="ImageSizeRow" HorizontalAlignment="Left">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <local:Vector2Field x:Name="ImageSizeInput" Label="크기" X="64" Y="64" Minimum="1" Maximum="8192" Step="1" DecimalPlaces="0"/>
       <local:BoolField x:Name="AutoSize" Grid.Column="1" Label="Auto" LabelWidth="48" VerticalAlignment="Center" Margin="12,0,0,0" ValueChanged="AutoSizeChanged"/>
      </Grid>
      <TextBlock x:Name="FieldError" Foreground="{DynamicResource PixelAccentBrush}" Margin="0,8,0,0" Visibility="Collapsed"/>
      <ContentControl x:Name="QuestionsHost"/>
      <StackPanel x:Name="IconQuestions" Margin="0,16,0,0" Visibility="Collapsed">
       <StackPanel x:Name="RequestFields">
        <local:StringField x:Name="ItemSubject" Label="그릴 대상 *" InputWidth="200" MaxLength="200" ValueChanged="RequestChanged" ToolTip="무엇을 그릴지 입력합니다. 예: 붉은 보석 반지, 얼음 속성 룬" Margin="0,0,0,10"/>
        <local:DropdownField x:Name="ArtStyle" Label="그림체 *" ValueChanged="RequestChanged" Margin="0,0,0,10"/>
        <local:DropdownField x:Name="ViewAngle" Label="시점 *" ValueChanged="RequestChanged" Margin="0,0,0,10"/>
        <Grid Margin="0,0,0,10" HorizontalAlignment="Left">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <local:ColorField x:Name="PaletteInput" Label="주요 색상" IsEnabled="False"/>
         <local:BoolField x:Name="UseReferencePalette" Grid.Column="1" Label="예시 색감 사용" LabelWidth="100" Value="True" ValueChanged="PaletteModeChanged" Margin="12,0,0,0"/>
        </Grid>
        <local:BoolField x:Name="TransparentInput" Label="투명 배경" Value="True" Margin="0,0,0,10"/>
        <local:NumberField x:Name="PaddingInput" Label="여백 (px)" Value="4" Minimum="0" Maximum="64" Step="1" DecimalPlaces="0" Margin="0,0,0,14"/>
        <DockPanel Margin="0,0,0,8">
         <TextBlock Text="예시 이미지 *" VerticalAlignment="Center" Margin="0,0,16,0"/>
         <StackPanel Orientation="Horizontal"><Button Content="이미지 선택" Click="ChooseReference"/><Button x:Name="ClearReferenceButton" Content="비우기" Click="ClearReference" IsEnabled="False"/></StackPanel>
        </DockPanel>
        <Border Background="{DynamicResource PixelBackgroundBrush}" BorderBrush="{DynamicResource PixelBorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,14">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image x:Name="ReferencePreview" Width="96" Height="96" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          <TextBlock x:Name="ReferenceInfo" Grid.Column="1" Text="예시 이미지를 선택해 주세요." Margin="12,0,0,0" VerticalAlignment="Center"/>
         </Grid>
        </Border>
        <TextBlock Text="커스텀" Margin="0,0,0,6"/>
        <TextBox x:Name="CustomRequest" Style="{StaticResource CustomText}" Height="84" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000"/>
        <TextBlock Text="예: 예시 이미지에 테두리만 추가해 줘. / 이 이미지와 같은 그림체로 만들어 줘." Foreground="{DynamicResource PixelMutedTextBrush}" FontSize="11" Margin="0,6,0,12"/>
       </StackPanel>
       <TextBlock Text="만들기를 누르면 선택한 예시 이미지와 입력 내용이 외부 AI로 전송됩니다." Foreground="{DynamicResource PixelMutedTextBrush}" FontSize="11" Margin="0,0,0,10"/>
       <StackPanel Orientation="Horizontal"><Button x:Name="GenerateButton" Content="만들기" Click="GenerateClick" IsEnabled="False" MinWidth="110"/><Button x:Name="CancelGenerationButton" Content="취소" Click="CancelGeneration" Visibility="Collapsed"/></StackPanel>
       <ProgressBar x:Name="GenerationProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource PixelAccentBrush}" Background="{DynamicResource PixelBackgroundBrush}" Margin="0,10,0,0"/>
       <TextBlock x:Name="GenerationStatus" Margin="0,8,0,0"/>
      </StackPanel>
     </StackPanel>
     </ScrollViewer>
    </Border>
    <Border x:Name="ModeNoticePanel" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource Panel}" Visibility="Collapsed">
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
      <TextBlock x:Name="ModeNoticeTitle" Text="준비 중입니다" FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/>
     </StackPanel>
    </Border>
   </Grid>
 </Grid>
</UserControl>
