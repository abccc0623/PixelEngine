<UserControl x:Class="PixelTool.ToolbarButton"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PixelTool"
             mc:Ignorable="d" 
             d:DesignHeight="44" d:DesignWidth="44" HorizontalAlignment="Center" VerticalAlignment="Center">



    <UserControl.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#202630"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PixelAccentBrush}"/>
                                <Setter Property="Foreground" Value="#202630"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
        <Button x:Name="MainHoverButton" 
            Style="{StaticResource RoundedButtonStyle}"
            Content="{Binding ButtonIcon, ElementName=Root}"
            FontFamily="Segoe MDL2 Assets"
            Width="38" Height="38"
            Margin="3"
            FontSize="16"
            Background="Transparent" Foreground="{StaticResource PixelTextBrush}"
            BorderBrush="Transparent" BorderThickness="0"
            Click="MainHoverButton_Click"
            MouseEnter="MainHoverButton_MouseEnter"
            MouseLeave="MainHoverButton_MouseLeave"/>

        <Popup x:Name="SubMenuPopup" 
           PlacementTarget="{Binding ElementName=MainHoverButton}" 
           Placement="Right"
           HorizontalOffset="7"
           AllowsTransparency="True"
           PopupAnimation="Fade">

            <Border Background="{StaticResource PixelPanelBrush}"
                BorderBrush="{StaticResource PixelBorderBrush}"
                BorderThickness="1" 
                CornerRadius="8"
                Padding="14"
                MinWidth="220"
                MouseEnter="SubMenuPopup_MouseEnter"
                MouseLeave="SubMenuPopup_MouseLeave">
                <StackPanel>
                    <ContentPresenter Content="{Binding PopupContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
            </Border>
        </Popup>

    </Grid>
</UserControl>
