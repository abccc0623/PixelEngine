<UserControl x:Class="PixelTool.ToolbarWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PixelTool"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="54">


    <UserControl.Resources>
        <Style TargetType="Button" x:Key="ToolbarActionButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PixelTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PixelAccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PixelBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PixelAccentMutedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PixelAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="EditorMenuItemButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PixelTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="MinWidth" Value="190"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PixelButtonHoverBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PixelAccentBrush}"/>
                    <Setter Property="Foreground" Value="#202630"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Border DockPanel.Dock="Top"
        Background="{StaticResource PixelPanelBrush}"
        BorderBrush="{StaticResource PixelDockBorderBrush}"
        Margin="4,8,4,0"
        BorderThickness="1"
        CornerRadius="12">

        <Grid x:Name="ToolbarTrack" Width="44" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5">
            <Border x:Name="SelectionIndicator"
                    Width="38" Height="38"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="{StaticResource PixelAccentBrush}"
                    BorderThickness="0"
                    CornerRadius="19"
                    IsHitTestVisible="False"
                    Panel.ZIndex="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SelectionTransform"/>
                </Border.RenderTransform>
            </Border>

            <StackPanel x:Name="ToolbarItems" Orientation="Vertical" Panel.ZIndex="1">

                <ToggleButton x:Name="EditorPlayToggle"
                              Style="{DynamicResource PixelModeToggle}"
                              Margin="0,0,0,6"
                              Checked="EditorPlayToggle_Changed"
                              Unchecked="EditorPlayToggle_Changed"
                              ToolTip="Current Mode: Editor"/>

                <local:ToolbarButton x:Name="CreateToolbarButton" Width="44" Height="44" ButtonIcon=""
                                     ToolHovered="ToolbarButton_Hovered" ToolHoverEnded="ToolbarButton_HoverEnded">
                    <local:ToolbarButton.PopupContent>
                        <StackPanel >
                            <TextBlock Text="CREATE SCRIPT" Foreground="{StaticResource PixelAccentBrush}" FontSize="14" Margin="12,9,0,8" FontWeight="Bold"/>
                            <Button Content="Main Lua File" Style="{StaticResource EditorMenuItemButton}" Click="CreateMainLuaFile" />
                            <Button Content="Scene Lua File" Style="{StaticResource EditorMenuItemButton}" Click="CreateSceneLuaFile" />
                            <Button Content="Module Lua File" Style="{StaticResource EditorMenuItemButton}" Click="CreateModuleLuaFile" />
                            <TextBlock Text="CREATE ASSET" Foreground="{StaticResource PixelAccentBrush}" FontSize="14" Margin="12,15,0,8" FontWeight="Bold"/>
                            <Button Content="Material" Style="{StaticResource EditorMenuItemButton}" Click="CreateMaterial" />
                            <Button Content="Collider" Style="{StaticResource EditorMenuItemButton}" Click="CreateCollider" />
                        </StackPanel>
                    </local:ToolbarButton.PopupContent>
                </local:ToolbarButton>

                <local:ToolbarButton x:Name="SceneToolbarButton" Width="44" Height="44" ButtonIcon=""
                                     ToolHovered="ToolbarButton_Hovered" ToolHoverEnded="ToolbarButton_HoverEnded">
                    <local:ToolbarButton.PopupContent>
                        <StackPanel >
                            <TextBlock Text="SAVE" Foreground="{StaticResource PixelAccentBrush}" FontSize="14" Margin="12,9,0,8" FontWeight="Bold"/>
                            <Button Content="Save Scene" Style="{StaticResource EditorMenuItemButton}" Click="SceneSave"/>
                            <TextBlock Text="LOAD" Foreground="{StaticResource PixelAccentBrush}" FontSize="14" Margin="12,15,0,8" FontWeight="Bold"/>
                            <Button Content="Load Scene" Style="{StaticResource EditorMenuItemButton}" Click="LoadScene"/>
                        </StackPanel>
                    </local:ToolbarButton.PopupContent>
                </local:ToolbarButton>

                <local:ToolbarButton x:Name="SettingsToolbarButton" Width="44" Height="44" ButtonIcon=""
                                     ToolHovered="ToolbarButton_Hovered" ToolHoverEnded="ToolbarButton_HoverEnded">
                    <local:ToolbarButton.PopupContent>
                        <StackPanel>
                            <TextBlock Text="PROJECT SETTINGS" Foreground="{StaticResource PixelAccentBrush}" FontSize="14" Margin="12,9,0,8" FontWeight="Bold"/>
                            <Button Content="Physics Layers" Style="{StaticResource EditorMenuItemButton}" Click="OpenLayerSettings"/>
                            <Button Content="Reset Editor Layout" Style="{StaticResource EditorMenuItemButton}" Click="ResetEditorLayout"/>
                        </StackPanel>
                    </local:ToolbarButton.PopupContent>
                </local:ToolbarButton>

                <Button Content=""
                        Style="{StaticResource ToolbarActionButton}"
                        ToolTip="Engine Update"
                        Click="UpdateEngineFiles"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
