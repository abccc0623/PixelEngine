<Window x:Class="PixelTool.LuaDataTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PixelTool"
        Title="Lua Data Table"
        Width="900"
        Height="620"
        MinWidth="700"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PixelBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="TableButton" TargetType="Button">
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource PixelButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PixelButtonTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PixelBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Lua Data Table"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource PixelTextBrush}"/>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                       Text="File Name" Foreground="{DynamicResource PixelTextBrush}"/>
            <TextBox x:Name="FileNameTextBox" Grid.Column="1" Padding="7,5"
                     Background="{DynamicResource PixelPanelBrush}"
                     Foreground="{DynamicResource PixelTextBrush}"
                     BorderBrush="{DynamicResource PixelBorderBrush}"/>
            <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                       Text=".lua" Foreground="{DynamicResource PixelTextBrush}"/>
            <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="Asset/Table/" Opacity="0.75"
                       Foreground="{DynamicResource PixelTextBrush}"/>
        </Grid>

        <DataGrid x:Name="TableGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  SelectionUnit="FullRow"
                  Background="{DynamicResource PixelPanelBrush}"
                  Foreground="{DynamicResource PixelTextBrush}"
                  BorderBrush="{DynamicResource PixelBorderBrush}"
                  RowBackground="{DynamicResource PixelPanelBrush}"
                  AlternatingRowBackground="{DynamicResource PixelBackgroundBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Group" Binding="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTemplateColumn Header="Type" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{x:Static local:LuaDataTableWindow.ValueTypeOptions}"
                                      SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="False"
                                      Padding="5,2"
                                      Background="{DynamicResource PixelPanelBrush}"
                                      Foreground="{DynamicResource PixelTextBrush}"
                                      BorderBrush="{DynamicResource PixelBorderBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource TableButton}" Content="Add" Click="AddRow_Click"/>
                <Button Style="{StaticResource TableButton}" Content="Delete" Click="DeleteRow_Click"/>
                <Button Style="{StaticResource TableButton}" Content="Up" Click="MoveUp_Click"/>
                <Button Style="{StaticResource TableButton}" Content="Down" Click="MoveDown_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource TableButton}" Content="New" Click="NewFile_Click"/>
                <Button Style="{StaticResource TableButton}" Content="Load" Click="LoadFile_Click"/>
                <Button Style="{StaticResource TableButton}" Margin="0" Content="Save" Click="SaveFile_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
