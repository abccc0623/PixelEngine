<UserControl x:Class="PixelTool.AssetWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource PixelBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="180"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="440" MinWidth="140"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="5" Margin="0,0,0,1"
                   Background="{StaticResource PixelPanelBrush}" LastChildFill="True">
            <Button Content="&#xE72B;" Width="30" Margin="5,4,3,4" Style="{StaticResource PixelIconButton}"
                    ToolTip="Parent folder" Click="GoParentFolder"/>
            <Button Content="&#xE8B7;" Width="30" Margin="0,4,3,4" Style="{StaticResource PixelIconButton}"
                    ToolTip="Open project folder" Click="OpenProjectFolder"/>
            <Button Content="Import" Width="60" Margin="0,4,3,4" Style="{StaticResource PixelToolButton}" Click="ImportFiles"/>
            <Button Content="Refresh" Width="64" Margin="0,4,8,4" Style="{StaticResource PixelToolButton}" Click="RefreshAll"/>
            <TextBox x:Name="SearchBox" Margin="0,4,6,4" Style="{StaticResource PixelTextBox}"
                     ToolTip="Search assets" TextChanged="SearchBox_TextChanged"/>
        </DockPanel>

        <TreeView x:Name="FolderView" Grid.Row="1" Grid.Column="0"
                  Background="{StaticResource PixelPanelBrush}" Foreground="{StaticResource PixelTextBrush}"
                  BorderThickness="0" Padding="5"
                  ItemsSource="{Binding FolderItems}" SelectedItemChanged="FolderView_SelectedItemChanged"
                  AllowDrop="True" DragOver="FolderView_DragOver" Drop="FolderView_Drop">
            <TreeView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#544B16"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#544B16"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
            </TreeView.Resources>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="ToolTip" Value="{Binding fullPath}"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding FolderItems}">
                    <StackPanel Orientation="Horizontal" Margin="2,3">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="New Folder" Click="FolderItem_Create"/>
                                <Separator/>
                                <MenuItem Header="Paste" Click="FolderItem_Paste" InputGestureText="Ctrl+V"/>
                                <MenuItem Header="Copy Folder Path" Click="FolderItem_CopyPath"/>
                                <MenuItem Header="Open In Explorer" Click="FolderItem_OpenExplorer"/>
                                <Separator/>
                                <MenuItem Header="Rename" Click="FolderItem_Rename"/>
                                <MenuItem Header="Delete" Click="FolderItem_Delete" Foreground="#FF6B6B"/>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" Foreground="#C6CCE0"/>
                        <TextBlock Text="{Binding folderName}" Foreground="{StaticResource PixelTextBrush}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <GridSplitter Grid.Row="1" Grid.Column="1" Background="{StaticResource PixelBorderBrush}"/>

        <ListView x:Name="FileView" Grid.Row="1" Grid.Column="2" HorizontalContentAlignment="Stretch"
                  Background="{StaticResource PixelBackgroundBrush}" ItemsSource="{Binding FileItems}"
                  SelectionMode="Extended"
                  MouseDoubleClick="FileView_MouseDoubleClick"
                  PreviewMouseLeftButtonDown="FileView_PreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="FileView_PreviewMouseLeftButtonUp"
                  PreviewMouseMove="FileView_PreviewMouseMove"
                  SelectionChanged="FileView_SelectionChanged" KeyDown="FileView_KeyDown"
                  DragOver="FileView_DragOver" Drop="FileView_Drop" AllowDrop="True" BorderThickness="0" Padding="4">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="New Lua File" Click="CreateNewLua"/>
                    <MenuItem Header="New PXM File" Click="CreateNewPxm"/>
                    <MenuItem Header="New Scene File" Click="CreateNewScene"/>
                    <Separator/>
                    <MenuItem Header="Import Files" Click="ImportFiles"/>
                    <MenuItem Header="Paste" Click="FileView_Paste" InputGestureText="Ctrl+V"/>
                    <MenuItem Header="Open Folder In Explorer" Click="FolderItem_OpenExplorer"/>
                    <Separator/>
                    <MenuItem Header="Refresh Folder" Click="RefreshFolder"/>
                    <MenuItem Header="Refresh All" Click="RefreshAll"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="FileViewItem_PreviewMouseRightButtonDown"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource PixelTextBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource PixelSurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PixelTextBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource PixelBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource PixelAccentMutedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PixelAccentBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource PixelAccentBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="3,4">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Cut" Click="FileItem_Cut" InputGestureText="Ctrl+X"/>
                                <MenuItem Header="Copy" Click="FileItem_Copy" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="Paste" Click="FileView_Paste" InputGestureText="Ctrl+V"/>
                                <Separator/>
                                <MenuItem Header="Copy Path" Click="FileItem_CopyPath"/>
                                <MenuItem Header="Open In Explorer" Click="FileItem_OpenExplorer"/>
                                <MenuItem Header="Duplicate" Click="FileItem_Duplicate"/>
                                <Separator/>
                                <MenuItem Header="Rename" Click="FileItem_NameChange"/>
                                <MenuItem Header="Delete" Click="FileItem_Delete" Foreground="#FF6B6B"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="0.6*"/>
                            <ColumnDefinition Width="0.15*"/>
                            <ColumnDefinition Width="0.15*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding FileIcon}" Grid.Column="0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}" FontSize="13"/>
                        <TextBlock Text="{Binding FileName}" Grid.Column="1" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Extension}" Grid.Column="2" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Opacity="0.72" FontSize="11"/>
                        <TextBlock Text="{Binding FileSize}" Grid.Column="3" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Opacity="0.72" FontSize="11"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <GridSplitter Grid.Row="1" Grid.Column="3"
                      Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                      Background="{StaticResource PixelBorderBrush}" Cursor="SizeWE"/>

        <Border Grid.Row="1" Grid.Column="4" Background="{StaticResource PixelPanelBrush}" Padding="4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Bottom" Margin="10">
                    <TextBlock x:Name="PreviewFileName" Foreground="{StaticResource PixelTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PreviewFileInfo" Foreground="{StaticResource PixelMutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PreviewFilePath" Foreground="#6F778A" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <Image x:Name="TexturePreview" Stretch="Uniform" Margin="12"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
