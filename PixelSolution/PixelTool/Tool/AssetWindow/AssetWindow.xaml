<UserControl x:Class="PixelTool.AssetWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PixelTool"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="1.0*"/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="4"
                   Background="{StaticResource PixelBackgroundBrush}"
                   LastChildFill="True">
            <Button Content="Up" Width="44" Margin="2" Click="GoParentFolder"/>
            <Button Content="Import" Width="64" Margin="2" Click="ImportFiles"/>
            <Button Content="Refresh" Width="68" Margin="2" Click="RefreshAll"/>
            <TextBox x:Name="SearchBox"
                     Margin="4,2"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
        </DockPanel>

        <TreeView x:Name="FolderView" Grid.Row="1" Grid.Column="0"
                  Background="{StaticResource PixelBackgroundBrush}"
                  ItemsSource="{Binding FolderItems}"
                  SelectedItemChanged="FolderView_SelectedItemChanged"
                  AllowDrop="True"
                  Drop="FolderView_Drop">
            <TreeView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#484A77" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#484A77" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
            </TreeView.Resources>

            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="ToolTip" Value="{Binding fullPath}"/>
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding FolderItems}">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <StackPanel.ContextMenu>
                            <ContextMenu Background="#25263D" Foreground="White" BorderBrush="#1B1C2E">
                                <MenuItem Header="New Folder" Click="FolderItem_Create"/>
                                <MenuItem Header="Copy Folder Path" Click="FolderItem_CopyPath"/>
                                <MenuItem Header="Open In Explorer" Click="FolderItem_OpenExplorer"/>
                                <Separator Background="#444"/>
                                <MenuItem Header="Rename" Click="FolderItem_Rename"/>
                                <MenuItem Header="Delete" Click="FolderItem_Delete" Foreground="#FF6B6B"/>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <TextBlock Text="📁" Margin="0,0,5,0" Foreground="White"/>
                        <TextBlock Text="{Binding folderName}" Foreground="White"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <GridSplitter Grid.Row="1" Grid.Column="1" Background="{StaticResource PixelBackgroundBrush}"/>

        <ListView x:Name="FileView" Grid.Row="1" Grid.Column="2"
                  HorizontalContentAlignment="Stretch"
                  Background="{StaticResource PixelBackgroundBrush}"
                  ItemsSource="{Binding FileItems}"
                  MouseDoubleClick="FileView_MouseDoubleClick"
                  PreviewMouseLeftButtonDown="FileView_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="FileView_PreviewMouseMove"
                  SelectionChanged="FileView_SelectionChanged"
                  KeyDown="FileView_KeyDown"
                  Drop="FileView_Drop"
                  AllowDrop="True"
                  BorderThickness="0">

            <ListView.ContextMenu>
                <ContextMenu Background="#25263D" Foreground="White" BorderBrush="#1B1C2E">
                    <MenuItem Header="New Lua File" Click="CreateNewLua"/>
                    <MenuItem Header="New PXM File" Click="CreateNewPxm"/>
                    <MenuItem Header="New Scene File" Click="CreateNewScene"/>
                    <Separator Background="#444"/>
                    <MenuItem Header="Import Files" Click="ImportFiles"/>
                    <MenuItem Header="Open Folder In Explorer" Click="FolderItem_OpenExplorer"/>
                    <Separator Background="#444"/>
                    <MenuItem Header="Refresh Folder" Click="RefreshFolder"/>
                    <MenuItem Header="Refresh All" Click="RefreshAll"/>
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#484A77"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2E2F4A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ContextMenu>
                            <ContextMenu Background="#25263D" Foreground="White" BorderBrush="#1B1C2E">
                                <MenuItem Header="Copy Path" Click="FileItem_CopyPath"/>
                                <MenuItem Header="Open In Explorer" Click="FileItem_OpenExplorer"/>
                                <MenuItem Header="Duplicate" Click="FileItem_Duplicate"/>
                                <Separator Background="#444"/>
                                <MenuItem Header="Rename" Click="FileItem_NameChange"/>
                                <MenuItem Header="Delete" Click="FileItem_Delete" Foreground="#FF6B6B"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="0.6*"/>
                            <ColumnDefinition Width="0.15*"/>
                            <ColumnDefinition Width="0.15*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding FileIcon}" Grid.Column="0" Foreground="White" FontSize="13"/>
                        <TextBlock Text="{Binding FileName}" Grid.Column="1" Foreground="White" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Extension}" Grid.Column="2" Foreground="#888" FontSize="11"/>
                        <TextBlock Text="{Binding FileSize}" Grid.Column="3" Foreground="#888" FontSize="11"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="1" Grid.Column="3" Background="#1B1C2E">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Bottom" Margin="8">
                    <TextBlock x:Name="PreviewFileName" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PreviewFileInfo" Foreground="#AAAAAA" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PreviewFilePath" Foreground="#777777" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <Image x:Name="TexturePreview" Stretch="Uniform" Margin="10"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
