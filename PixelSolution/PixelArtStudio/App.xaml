<Application x:Class="PixelArtStudio.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Application.Resources>
<SolidColorBrush x:Key="Panel" Color="#1B2331" />
<Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Background" Value="#29415A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#526171"/></Trigger></Style.Triggers></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="#101722"/><Setter Property="Foreground" Value="#E8EEF7"/><Setter Property="BorderBrush" Value="#3C4B61"/><Setter Property="CaretBrush" Value="White"/></Style>

</Application.Resources></Application>
