<Window x:Class="PixelArtStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pixel Art Studio" Width="1180" Height="800" MinWidth="880" MinHeight="650" Background="#101722" Foreground="#E8EEF7" FontFamily="Segoe UI" Closing="Window_Closing">
<Grid Margin="24">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="PIXEL ART STUDIO" FontSize="25" FontWeight="Bold"/><TextBlock Text="로컬 GPU로 제작하는 게임 아트 · 단일 이미지" Foreground="#8DA1B9" Margin="0,5,0,22"/></StackPanel><TextBlock HorizontalAlignment="Right" Text="LOCAL / NO API FEE" Foreground="#69D4BA" Margin="0,9,0,0"/></Grid>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="280"/><ColumnDefinition Width="6"/><ColumnDefinition Width="400" MinWidth="320" MaxWidth="600"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18" Margin="0,0,6,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="미리보기" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>
<Border Grid.Row="1" CornerRadius="6" ClipToBounds="True"><Border.Background><DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#283241" Geometry="M0,0 H20 V20 H0Z"/><GeometryDrawing Brush="#202936" Geometry="M0,0 H10 V10 H0Z M10,10 H20 V20 H10Z"/></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Border.Background><Grid><Image x:Name="Preview" Stretch="Uniform" Margin="24" RenderOptions.BitmapScalingMode="NearestNeighbor"/><TextBlock x:Name="EmptyHint" Text="아이디어를 입력하고 생성하세요.&#10;기존 PNG를 열어 수정할 수도 있습니다." TextAlignment="Center" VerticalAlignment="Center" Foreground="#9DAEC3"/></Grid></Border>
<WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="OpenButton" Content="PNG 열기" Click="Open_Click"/><Button x:Name="ExportButton" Content="PNG 내보내기" Click="Export_Click" IsEnabled="False"/><TextBlock x:Name="ImageInfo" VerticalAlignment="Center" Foreground="#8DA1B9"/></WrapPanel>
</Grid></Border>
<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#3C4B61" ShowsPreview="True" ToolTip="드래그하여 미리보기/설정 폭 조절"/>
<Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="12" Margin="6,0,0,0"><DockPanel>
<Button x:Name="CancelButton" DockPanel.Dock="Bottom" Content="중지" Click="Cancel_Click" IsEnabled="False"/>
<Expander Header="공통 스타일 (두 탭 공유)" DockPanel.Dock="Top" Foreground="#E8EEF7" Margin="0,0,0,8"><ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SharedStylePanel"><TextBlock Text="프로젝트 공통 스타일 (영문)" FontWeight="Bold"/><TextBox x:Name="StylePromptBox" MaxLength="2000" Height="55" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="스타일 제외 설명"/><TextBox x:Name="StyleNegativeBox" MaxLength="2000"/><WrapPanel><Button Content="스타일 저장" Click="SaveStyle_Click"/><Button Content="스타일 불러오기" Click="LoadStyle_Click"/></WrapPanel><TextBlock Text="프로젝트 Editor 폴더에 스타일 JSON을 저장해 구분하세요. 다른 프로젝트로 자동 공유하지 않습니다. 공통 스타일/시드가 캐릭터 일관성을 보장하지는 않습니다." FontSize="11" Foreground="#8DA1B9" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Expander>
<TabControl Background="#1B2331" BorderBrush="#3C4B61" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
<TabItem Header="일감 생성" Foreground="#17202E"><DockPanel><Button x:Name="WorkItemGenerateButton" DockPanel.Dock="Bottom" Content="일감으로 생성" Click="GenerateWorkItem_Click" Background="#247B70"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8"><StackPanel TextElement.Foreground="#E8EEF7" x:Name="WorkItemPanel" Margin="0,0,0,18"><TextBlock Text="일감 가져오기" FontSize="16" FontWeight="Bold"/><ComboBox x:Name="WorkItemMode" SelectedIndex="0" Foreground="#17202E"><ComboBoxItem Content="Markdown 리소스 일감"/><ComboBoxItem Content="이미지 설명 텍스트"/><ComboBoxItem Content="구조화 JSON"/></ComboBox><TextBlock Text="Markdown의 ## 내용에서 이미지 설명/리소스 종류/출력 크기/배경/시드만 적용합니다. 영문 이미지 설명이 필수이며 나머지 원문은 모델에 보내지 않습니다. 텍스트는 그대로 prompt에 적용하며 현재 옵션을 유지합니다. JSON은 생략 값을 기본값으로 설정합니다." TextWrapping="Wrap" FontSize="11" Foreground="#8DA1B9" Margin="0,6,0,6"/><TextBlock Text="붙여넣기만으로 GPU가 실행되지 않습니다. 일감으로 생성을 누르면 검증 후 현재 일감을 적용하고 한 번 생성합니다. 공통 스타일은 두 탭에서 공유합니다." TextWrapping="Wrap" FontSize="11" Foreground="#69D4BA" Margin="0,0,0,8"/><TextBox x:Name="WorkItemBox" Height="240" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><WrapPanel><Button Content="MD/TXT 열기" Click="OpenWorkItem_Click"/></WrapPanel><TextBlock x:Name="WorkItemCriteria" Text="적용된 일감 없음" TextWrapping="Wrap" FontSize="11" Foreground="#8DA1B9"/></StackPanel></ScrollViewer></DockPanel></TabItem>
<TabItem Header="직접 설정" Foreground="#17202E"><DockPanel><WrapPanel DockPanel.Dock="Bottom"><Button x:Name="GenerateButton" Content="새 이미지 생성" Click="Generate_Click" Background="#247B70"/><Button x:Name="EditButton" Content="현재 이미지 수정" Click="Edit_Click" IsEnabled="False"/></WrapPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8"><StackPanel TextElement.Foreground="#E8EEF7"><StackPanel x:Name="FeaturePanel"><TextBlock Text="제작 종류"/><ComboBox x:Name="CategoryBox" SelectedIndex="0" SelectionChanged="Category_Changed" Foreground="#17202E"><ComboBoxItem Content="캐릭터"/><ComboBoxItem Content="배경"/><ComboBoxItem Content="타일"/></ComboBox><TextBlock Text="선택한 종류의 영문 지시를 자동으로 덧붙입니다. 배경/타일은 투명 체크를 끄세요. 타일 연결은 보장하지 않습니다." TextWrapping="Wrap" FontSize="11"/><WrapPanel><Button Content="설정 저장" Click="SaveSettings_Click"/><Button Content="설정 복원" Click="LoadSettings_Click"/></WrapPanel><TextBlock Text="제외할 내용 (negative prompt)"/><TextBox x:Name="NegativeBox" Text="blurry, photo, text, watermark"/></StackPanel><TextBlock Text="만들고 싶은 이미지" FontSize="16" FontWeight="SemiBold"/>
<TextBlock Text="영문 설명 권장 · 모델은 한국어 이해가 제한적입니다." FontSize="11" Foreground="#8DA1B9" Margin="0,5,0,10" TextWrapping="Wrap"/>
<TextBox x:Name="PromptBox" Height="116" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="pixel art, a small green forest slime, game sprite, centered, plain white background"/>
<TextBlock Text="수정 후 원하는 전체 모습" Margin="0,16,0,8"/>
<TextBox x:Name="EditBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="원하는 최종 모습의 영문 설명. '현재 이미지 수정'으로 실행합니다."/>
<TextBlock Text="변경 강도 · 높을수록 원본 형태도 달라집니다" FontSize="11" Margin="0,10,0,4"/><Slider x:Name="StrengthSlider" Minimum="0.1" Maximum="1" Value="0.6" TickFrequency="0.05" IsSnapToTickEnabled="True" AutoToolTipPlacement="BottomRight" AutoToolTipPrecision="2"/>
<TextBlock Text="출력 크기" Margin="0,14,0,8"/>
<ComboBox Foreground="#17202E" x:Name="SizeBox" SelectedIndex="1"><ComboBoxItem Content="32 × 32" Tag="32"/><ComboBoxItem Content="64 × 64" Tag="64"/><ComboBoxItem Content="128 × 128" Tag="128"/></ComboBox>
<CheckBox x:Name="TransparentBox" Content="배경 제거 후 투명 PNG" IsChecked="True" Foreground="#D7E1EF" Margin="0,14,0,3"/>
<CheckBox x:Name="ProtectInteriorBox" Content="작은 내부 누락 자동 복구" IsChecked="True" Foreground="#D7E1EF" Margin="0,8,0,3"/><TextBlock Text="작은 닫힌 구멍만 복구합니다. 외부와 연결되거나 큰 구멍은 제외합니다. 의도한 작은 구멍도 채울 수 있으니 필요시 끄세요." FontSize="11" TextWrapping="Wrap" Foreground="#8DA1B9"/><TextBlock Text="배경 제거는 후처리입니다. 미리보기에서 경계를 확인하세요." FontSize="11" Foreground="#8DA1B9" TextWrapping="Wrap"/>
<WrapPanel Margin="0,14,0,0"><StackPanel Width="125"><TextBlock Text="단계"/><TextBox x:Name="StepsBox" Text="20" Margin="0,5,12,0"/></StackPanel><StackPanel Width="170"><TextBlock Text="시드 (-1 = 무작위)"/><TextBox x:Name="SeedBox" Text="-1" Margin="0,5,0,0"/></StackPanel></WrapPanel>
<StackPanel x:Name="ImageToolsPanel" Margin="0,16,0,0"><TextBlock Text="원본 / 결과 비교 및 복구" FontWeight="Bold"/><WrapPanel><Button Content="원본 보기/복구" Click="Source_Click"/><Button Content="배경 제거 결과" Click="Processed_Click"/></WrapPanel><TextBlock Text="선택한 미리보기가 내보내기/수정 대상입니다. 원본은 768px로 결과보다 큽니다. 시트 크기도 달라집니다." FontSize="11" TextWrapping="Wrap"/><TextBlock Text="정확한 RGB 교체 (AI 사용 안 함)" Margin="0,8,0,0"/><WrapPanel><TextBox x:Name="FromColorBox" Text="#0080FF" Width="100"/><TextBox x:Name="ToColorBox" Text="#00FF80" Width="100"/></WrapPanel><WrapPanel><Button Content="색 교체" Click="Recolor_Click"/><Button Content="좌우 반전" Click="Flip_Click"/></WrapPanel><TextBlock Text="기준 캐릭터 / 프레임" FontWeight="Bold" Margin="0,12,0,0"/><Button Content="현재 이미지를 기준으로 고정" Click="PinReference_Click"/><TextBlock x:Name="ReferenceInfo" Text="기준 없음" TextWrapping="Wrap" FontSize="11"/><Button Content="기준으로 프레임 생성" Click="GenerateFrame_Click"/><TextBlock Text="수정 설명에 프레임 자세를 입력하세요. AI 형태/색 일관성은 보장되지 않습니다. 생성 결과를 검토 후 추가하세요." TextWrapping="Wrap" FontSize="11"/><Button Content="현재 이미지를 프레임에 추가" Click="AddFrame_Click"/><ListBox x:Name="FramesBox" Height="100" Foreground="#17202E"/><WrapPanel><Button Content="위" Click="FrameUp_Click"/><Button Content="아래" Click="FrameDown_Click"/><Button Content="제거" Click="RemoveFrame_Click"/></WrapPanel><Button Content="발 정렬 / 시트 만들기" Click="Sheet_Click"/><Button Content="시트 좌표 JSON 내보내기" Click="ExportMetadata_Click"/><TextBlock Text="알파 경계 바닥/중앙을 정렬한 한 줄 PNG와 좌표 JSON. 투명 프레임을 사용하세요." FontSize="11" TextWrapping="Wrap"/></StackPanel><TextBlock Text="Python 실행 파일" Margin="0,14,0,6"/><TextBox x:Name="PythonBox" FontSize="10" ToolTip="설치된 전용 Python 경로"/>

<TextBlock Text="최초 실행에는 약 8GB 모델 다운로드가 필요합니다. 생성 중에는 GPU를 사용하며 다른 앱이 느려질 수 있습니다." Foreground="#8DA1B9" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
</StackPanel></ScrollViewer></DockPanel></TabItem>
</TabControl></DockPanel></Border></Grid>
<StackPanel Grid.Row="2" Margin="0,18,0,0"><ProgressBar x:Name="Progress" Height="4" Maximum="100"/><TextBlock x:Name="Status" Text="준비" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBox x:Name="LogBox" Height="62" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/></StackPanel>
</Grid></Window>
